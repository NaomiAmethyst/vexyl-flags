// Drawn from its source by tools/svg2vexyl.py, and not checked against an official construction.
vexyl 1
meta {
  name "Naval Ensign of Sweden"
  encoder "User: David Newton"
  license "CC-BY-SA-3.0"
  source "https://commons.wikimedia.org/wiki/File:Naval_ensign_of_Sweden.svg"
}
palette {
  blue "#005293"
  yellow "#fecb00"
}
proportion hoist=5 fly=10

charge polygon blue {
  point fly=0 hoist=0
  point fly=10 hoist=0
  point fly=6 hoist=2
  point fly=6 hoist=3
  point fly=10 hoist=5
  point fly=0 hoist=5
}

charge rect yellow {
  fly 1
  hoist 5
  at fly=3 hoist=2.5
}

charge polygon yellow {
  point fly=0 hoist=2
  point fly=6 hoist=2
  point fly=10 hoist=2.5
  point fly=6 hoist=3
  point fly=0 hoist=3
}
