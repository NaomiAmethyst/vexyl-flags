// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Barcelona (province)"
  license "CC-BY-SA-3.0"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Barcelona_(province).svg"
}
palette {
  yellow "#fcdd09"
  red "#da121a"
  white "#ffffff"
}
proportion hoist=18 fly=27

field yellow

charge rect red {
  fly 27
  hoist 2
  at fly=13.5 hoist=3
  repeat line count=4 hoist=4
}

charge lozenge white {
  fly 10
  hoist 10
  at fly=13.5 hoist=9
}

charge polygon yellow {
  point fly=8.5 hoist=9
  point fly=13.5 hoist=4
  point fly=18.5 hoist=9
  point fly=13.5 hoist=14
  hollow 0.18
}

charge svg {
  at center
  fly 27
  hoist 18
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 27 18"><defs><clipPath id="c"><path d="m8.5,9 5,-5 5,5 -5,5z"></path></clipPath></defs><path d="M8.5,9h10m-5,-5v10" stroke-width="1.272" clip-path="url(#c)" stroke="#fcdd09" transform="matrix(1 0 0 1 0 0)"/><path d="M8.5,9h10m-5,-5v10" stroke-width="1.2" clip-path="url(#c)" stroke="#da121a" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}

charge polygon yellow {
  point fly=8.5 hoist=9
  point fly=13.5 hoist=4
  point fly=18.5 hoist=9
  point fly=13.5 hoist=14
  hollow 0.036
}
