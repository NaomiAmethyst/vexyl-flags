// Drawn from its source by tools/svg2vexyl.py, and not checked against an official construction.
vexyl 1
meta {
  name "Ibiza flag"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  adapted-from "https://commons.wikimedia.org/wiki/File:Ibiza_flag.svg" {
    author "Javitomad, HansenBCN"
    license "CC-BY-SA-4.0"
  }
}
palette {
  yellow "#fcdd09"
}
proportion hoist=2 fly=3

charge rect yellow {
  fly 3
  hoist 2
  at center
  opacity 0.99
}

charge svg {
  at center
  fly 3
  hoist 2
