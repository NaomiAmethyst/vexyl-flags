  red "#e60012"
  white "#ffffff"
  blue "#014099"
}
proportion hoist=1 fly=2

bars red white blue {
  ratio 2 1 2
}

charge ellipse white {
  fly 0.1875
  hoist 0.0181
  at fly=0.4007 hoist=0.6
  at fly=0.9326 hoist=0.4
}

