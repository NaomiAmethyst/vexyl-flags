vexyl 1
meta {
  name "Flag of Chochong"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Chochong.svg" {
    author "Sshu94"
    license "LicenseRef-Public-Domain"
  }
}
