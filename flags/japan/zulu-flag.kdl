vexyl 1
meta {
  name "Zulu flag"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Zulu_flag.svg"
}
palette {
  yellow "#ffff00"
  black "#000000"
  blue "#003399"
  red "#ff0000"
}
proportion hoist=2 fly=3

pile yellow {
  from top
  depth 1
}

chevrons black {
  depth 1.5
}

pile blue {
  from fly
  depth 1.5
}

pile red {
  from bottom
  depth 1
}
