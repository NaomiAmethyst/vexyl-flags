// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Kagawa Prefecture"
  encoder "Zscout370, Mike Rohsopht"
  license "CC-BY-SA-3.0"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Kagawa_Prefecture.svg"
}
palette {
  green "#005933"
}
proportion hoist=600 fly=900

field green

charge svg {
  at center
  fly 900
  hoist 600
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 600"><defs><clipPath id="a"><path d="M0 0h400v360H0z"></path></clipPath></defs><g stroke-width="80" clip-path="url(#a)" stroke="#ffffff" fill="none" transform="matrix(1 0 0 1 250 108)"><circle cx="-100" r="340" cy="400" stroke-width="80" stroke="#ffffff" fill="none"></circle><path d="M360 400A460 460 0 0 0 176 32m48 0A460 460 0 0 0 40 400" stroke-width="80" stroke="#ffffff" fill="none"></path></g></svg>
"""#
}
