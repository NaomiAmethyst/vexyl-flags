// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "ICS Whiskey"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:ICS_Whiskey.svg"
}
palette {
  blue "#0000ff"
  black "#000000"
  white "#ffffff"
  red "#ff0000"
}
proportion hoist=600 fly=600

canton {
  fly 600
  hoist 600
  field blue
  charge polygon black {
    point fly=0 hoist=0
    point fly=600 hoist=0
    point fly=600 hoist=600
    point fly=0 hoist=600
    hollow 2.5
  }
  charge rect white {
    fly 360
    hoist 360
    at fly=300 hoist=300
  }
  charge rect red {
    fly 120
    hoist 120
    at fly=300 hoist=300
  }
}
