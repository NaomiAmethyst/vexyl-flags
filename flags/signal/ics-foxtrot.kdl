palette {
  white "#ffffff"
  black "#000000"
  red "#ff0000"
}
proportion hoist=1 fly=1

canton {
  fly 1
  hoist 1
  field white
  charge polygon black {
    point fly=0 hoist=0
    point fly=1 hoist=0
    point fly=1 hoist=1
    point fly=0 hoist=1
    hollow 0.0043
  }
  charge lozenge red {
    fly 1
    hoist 1
    at center
  }
}
