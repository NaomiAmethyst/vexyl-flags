// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Pony Pride Flag"
  encoder "Carrie (MysticStorm) and Tanos"
  license "CC-BY-3.0"
  source "https://commons.wikimedia.org/wiki/File:Pony_Pride_Flag.svg"
}
palette {
  black "#000000"
  white "#ffffff"
  blue "#0054a5"
  green "#006f3a"
}
proportion hoist=414 fly=690

bars black white blue white black {
  ratio 53 8 16 8 53
}

charge disc white {
  radius 157
  at fly=345 hoist=207
}

charge disc green {
  radius 147
  at fly=345 hoist=207
}

