  point fly=1.25 hoist=0.3333
  point fly=1.5 hoist=0
  point fly=1.75 hoist=0.3333
}

pile black {
  from bottom
  base 0.5 2.5
  depth 1.3333
}

pile brown {
  from bottom
  base 0.625 2.375
  depth 1.1667
}

pile teal {
  from bottom
  base 0.75 2.25
