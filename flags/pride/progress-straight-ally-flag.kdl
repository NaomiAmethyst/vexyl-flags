// Drawn from its source by tools/svg2vexyl.py, and not checked against an official construction.
vexyl 1
meta {
  name "Progress Straight Ally Flag"
  encoder "FireDragonValo"
  license "CC0-1.0"
  source "https://commons.wikimedia.org/wiki/File:Progress_Straight_Ally_Flag.svg"
}
palette {
  black "#000000"
  white "#ffffff"
  pink "#750787"
  blue "#004dff"
  green "#008026"
  yellow "#ffed00"
  orange "#ff8c00"
  red "#e40303"
  brown "#613915"
  teal "#74d7ee"
  light-pink "#ffafc8"
}
proportion hoist=2 fly=3

bars black white {
  count 6
}

charge polygon pink {
  point fly=0.25 hoist=1.6667
  point fly=1.25 hoist=0.6667
  point fly=1.25 hoist=1.6667
  point fly=1 hoist=2
  point fly=0 hoist=2
}

charge polygon pink {
  point fly=2.75 hoist=1.6667
  point fly=1.75 hoist=0.6667
  point fly=1.75 hoist=1.6667
  point fly=2 hoist=2
  point fly=3 hoist=2
}

charge polygon blue {
  point fly=0.5 hoist=1.3333
  point fly=1.5 hoist=1
  point fly=2.5 hoist=1.3333
  point fly=2.75 hoist=1.6667
  point fly=1.75 hoist=1.6667
  point fly=1.5 hoist=1.3333
  point fly=1.25 hoist=1.6667
  point fly=0.25 hoist=1.6667
}

charge polygon green {
  point fly=0.75 hoist=1
  point fly=1.5 hoist=0.6667
  point fly=2.25 hoist=1
  point fly=2.5 hoist=1.3333
  point fly=0.5 hoist=1.3333
}

charge polygon yellow {
  point fly=1 hoist=0.6667
  point fly=1.5 hoist=0.3333
  point fly=2 hoist=0.6667
  point fly=2.25 hoist=1
  point fly=0.75 hoist=1
}

