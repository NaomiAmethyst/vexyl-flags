// Seven equal bars, 21 by 35, so each is 3. The paw is the Commons path in its own 595 by 357 box.
vexyl 1
meta {
  name "International Bear Brotherhood Flag"
  designer "Craig Byrnes"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-3.0"
  date "1995"
  adapted-from "https://commons.wikimedia.org/wiki/File:Bear_Brotherhood_flag.svg" {
    author "Fibonacci."
    license "CC-BY-SA-3.0"
    part "the paw print"
  }
  source "http://web.archive.org/web/20120211094128/http://www.bearmfg.com/history/history.html"
  source "https://bearworldmag.com/the-bear-flag-craig-byrnes-and-the-international-bear-brotherhood-flag"
  source "https://crwflags.com/fotw/Flags/qq-ibbf.html"
  source "https://commons.wikimedia.org/wiki/File:Bear_Brotherhood_flag.svg"
  design-rights "Bear Manufacturing's page, the designer's own company, is marked Copyright 1995 VA 763-760 with the flag's name trademarked. Les K. Wright in Bear World Magazine (2024) says he was present when the designer handed the flag over to the bear community, placing it in the public domain. The two statements were not reconciled. This file's license covers the encoding, not the design."
  note "Bear Manufacturing's history page (the designer's company, Wayback snapshot of 11 Feb 2012, site last updated 2004) says Craig Byrnes made a crayon drawing for his senior psychology project, had Paul Witzkoske make four computer templates, and had four 3 by 5 foot prototypes sewn and shown at the Chesapeake Bay Bears 'Bears of Summer' event in July 1995, where the winning design was voted. It describes the winner as a field of simple horizontal stripes with a paw print in the upper left corner, in colors representing the fur colors and nationalities of bears."
  note "That page does not list the stripe colors, count them or give shades. Seven stripes, in order brown, rust, gold, tan, white, gray, black, come from Bear World Magazine and FOTW, which quotes Witzkoske's own colors as brown, rust, gold, cream, white, gray and black. FOTW says the shades vary and are not fixed, and Bear World notes the original colors have no exact Pantone equivalents."
  note "The shades are the Commons drawing's: #623804, #d56300, #fedd63, #fee6b8, #ffffff, #555555, #000000. The drawing's 595 by 357 shape is 5:3 and its stripes are 51 each, so they are equal. The paw's size and position are the drawing's, spanning the top four bars. FOTW notes that Witzkoske's four prototypes included green cantons and brown paws, which this design does not have; the winning flag is the black-paw one."
  note "The paw is real artwork, a path taken unchanged from the Commons drawing. The drawing also paints the black bottom bar as part of the same path; here that bar is an ordinary bar."
}
palette {
  brown "#623804"
  orange "#d56300"
  yellow "#fedd63"
  cream "#fee6b8"
  white "#ffffff"
  grey "#555555"
  black "#000000"
}
proportion hoist=21 fly=35

bars brown orange yellow cream white grey black

charge path black {
  d "M98.9 24.4c-5.7 0-11.5 1.3-16.3 4.4C61.2 42.6 91.1 48.3 96 51.1c4.7 2.7 22.4 22.9 29.7-8.4 2.2-9.7-12.2-18.3-26.8-18.3m45.4 11.2c-17.7 1.9-.8 43 23.6 44.4 16.5.9 28.9-39.3-23.6-44.4m-94.4 8.9C34.2 44 43.7 73.3 69 83.6c5.1 2.1 14.2-4.7 14.4-16 .1-4.2-7.1-22.2-33.5-23.1m61 17.7c-7.1-.1-14.6 3-22.8 11.5-28.9 30.3 13.8 35.5 10.6 51.9-9.7 48.5-.9 52.5 8.3 55.6 11.7 3.9 33.8-33.4 43.1-40.4 12.4-9.4 77.9-42.2 62.4-58.8-22.3-23.8-27 7.3-57.7-1-14.6-3.9-28.3-18.8-43.9-18.8M54.4 96.5c-2.8-.1-5.5.4-8.1 1.6-11.5 5.2 10.8 36.5 20.9 37.4 12.4 1.1 17.4-8.9 17.6-14.7.3-7.6-15.4-24-30.4-24.3m4 46.7c-4.5.1-8 1.2-9.6 3.3-4.1 6.2 21.6 30.4 28.7 32 6.5 1.5 12.6-13 11.4-18.7-2.2-10.4-19.2-16.7-30.5-16.6"
  box "0 0 595 357"
  fly 35
  hoist 21
  at center
}
