// Three equal bars on a 3:5 field.
vexyl 1
meta {
  name "Genderqueer pride flag"
  designer "Marilyn Roxie"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  design-rights "Public domain, previously CC-BY-4.0, by the designer's statement on the page cited"
  date "2012-06"
  series "genderqueer-flag"
  version "3.0"
  source "https://web.archive.org/web/20240315223727/https://marilynroxie.com/GENDERQUEER-FLAG"
  source "https://web.archive.org/web/20220927082231/https://majesticmess.com/encyclopedia/genderqueer-flag/"
  source "https://commons.wikimedia.org/wiki/File:Genderqueer_Pride_Flag.svg"
  note "Defining source: Marilyn Roxie's own page, read at the snapshot above. It says this is the third and final version, created in June 2011 with a true-color update in June 2012, after version 1.0 in June 2010 and 2.0 in September 2010. Lavender #b57edc, white #ffffff, dark chartreuse green #4a8123, which was #498022 before the update and is now the exact inverse of the lavender. The date is that of the color update, since these are its colors. Versions 1.0 and 2.0 are not written."
  note "The page gives no proportion; three equal bars at 3:5 follow the Commons drawing."
}
palette {
  lavender "#b57edc"
  white "#ffffff"
  green "#4a8123"
}
proportion hoist=3 fly=5

bars lavender white green
