// 5:3, seven equal bars. The kiss is the Commons drawing's 462.029 by 418.845 box at 61.182, 37.155 of its 1575 by 945,
// so on the 5 by 3 grid (315 to a unit) it is 1.4668 by 1.3297, centered at 0.9276 and 0.7828.
vexyl 1
meta {
  name "Lipstick Lesbian Pride Flag"
  designer "Natalie McCray"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  adapted-from "https://commons.wikimedia.org/wiki/File:Lipstick_lesbian_Pride_Flag.svg" {
    author "The Anome, from the EmojiOne 2.2.7 kiss mark (Emojione 1F48B.svg, CC-BY-4.0); file first drawn by xles"
    license "CC-BY-SA-4.0"
    part "the kiss"
  }
  date "2010-07"
  series "lipstick-lesbian"
  version "kiss"
  source "https://web.archive.org/web/20161011120237/https://thislesbianlife.files.wordpress.com/2010/07/llflag1.jpg"
  source "https://en.wikipedia.org/wiki/Lesbian_flags"
  source "https://commons.wikimedia.org/wiki/File:Lipstick_lesbian_Pride_Flag.svg"
  note "The designer's own image, 'LLFlag' on her blog This Lesbian Life (Wayback Machine, 11 October 2016; the file's path is dated July 2010), shows seven bars and a pink kiss mark at the top left. Wikipedia and the Horniman Museum give Natalie McCray as designer and 2010 as the year."
  note "The colors are the image's, read as the average at the center of each bar of the 1892 by 1204 pixel JPEG: #a40061, #b75592, #d063a6, #ededeb, #e4accf, #c54e54 and #8a1e04. They match the Commons drawing exactly. The JPEG is a raster, so they carry its compression error."
  note "The designer's image has bars at 0, 168, 348, 520, 692, 856, 1028 and 1204 pixels, close to seven of 172, and a proportion of 1892:1204, 11:7. This file uses seven equal bars and the Commons proportion, 5:3, since the image is a blog illustration and no source states the flag's proportion."
  note "The kiss is the Commons drawing's, in its own colors with a thin black outline, used unchanged. The file's history says The Anome redrew it in December 2019 by combining a kiss-less flag with the EmojiOne 2.2.7 kiss mark (licensed CC BY 4.0), replacing the kiss xles drew in 2015. Wikipedia says that drawing isn't the original design, because the kiss graphic has been modified. The designer's own kiss is a raster, and is placed differently: larger, over the top four bars, and reaching about 0.41 of the length where the Commons kiss reaches 0.33."
}
palette {
  magenta "#a40061"
  rose "#b75592"
  pink "#d063a6"
  white "#ededeb"
  pale-pink "#e4accf"
  salmon "#c54e54"
  brick "#8a1e04"
}
proportion hoist=3 fly=5

bars magenta rose pink white pale-pink salmon brick

