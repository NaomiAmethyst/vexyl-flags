// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Gay Pride flag of the United Kingdom"
  encoder "Fry1989 eh?"
  license "CC-BY-SA-3.0"
  source "https://commons.wikimedia.org/wiki/File:Gay_Pride_flag_of_the_United_Kingdom.svg"
}
palette {
  pink "#fa87d2"
  white "#ffffff"
  pink-2 "#e00034"
}
proportion hoist=300 fly=600

field pink

saltire white {
  width 60
}

charge svg {
  at center
  fly 600
  hoist 300
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 300"><defs><clipPath id="a"><path d="M300 150h300v150zv150H0zH0V0zV0h300z"></path></clipPath></defs><path d="m0 0 600 300m0-300L0 300" stroke-width="40" clip-path="url(#a)" stroke="#e00034" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}

cross pink-2 {
  fly 270 60 270
  hoist 120 60 120
  fimbriate white 20
}
