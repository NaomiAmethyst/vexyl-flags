// From Law 5.700, Article 5, in modules: 14 x 20, lozenge 16.6 x 10.6 and disc radius 3.5,
// as in this project's file for Brazil. The six stripes are equal, 14/6 each.
vexyl 1
meta {
  name "Brazil gay flag"
  designer "Greg Gomes"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Brazil.svg" {
    author "Wikimedia Commons contributors, listed in the file's history"
    license "LicenseRef-Public-Domain"
    part "the band, the lettering and the star coordinates"
  }
  source "https://web.archive.org/web/20110712184904/http://gayflags.biz/flags_gay/gay_flags_national.html"
  source "https://commons.wikimedia.org/wiki/File:Brazil_Gay_flag.svg"
  source "https://web.archive.org/web/2024/https://www.planalto.gov.br/ccivil_03/leis/l5700compilado.htm"
  note "Commons says its drawing is a remake of the Brazil entry on the National Gay Flags of the World page, gayflags.biz, and that page's 2011 snapshot says the flags marked with a small icon, which includes Brazil, are Greg Gomes's designs. The picture itself could not be fetched, so the design was not seen. Only the attribution is from the source."
  note "The construction is the Brazilian national flag's, from Law 5.700 as amended by Law 8.421, exactly as this project's file for Brazil has it, including the band, lettering and stars from the Commons flag of Brazil file. Where Commons' gay drawing disagrees, this file follows the law: Commons draws 1:1.6187, not 14:20, and a smaller lozenge."
  note "The change from the national flag is the stripes, in place of the green field. The stripe colors and the lozenge's #ffcb00 and the disc's #302681 are the Commons gay drawing's, not the law's, which gives no shades."
}
palette {
  red "#e50000"
  orange "#ff8d00"
  yellow "#ffee00"
  green "#028121"
  blue "#004cff"
  violet "#770088"
  gold "#ffcb00"
  navy "#302681"
  white "#ffffff"
}
proportion hoist=14 fly=20

bars red orange yellow green blue violet
charge lozenge gold {
  fly 16.6
  hoist 10.6
  at center
}
charge disc navy {
  radius 3.5
  at center
}
charge svg {
  at center
  fly 20
  hoist 14
  markup #"""
