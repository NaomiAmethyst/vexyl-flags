// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Ingushetia"
  encoder "Mysid"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Ingushetia.svg"
}
palette {
  green "#00923f"
  white "#ffffff"
  red "#d81e05"
}
proportion hoist=400 fly=600

bars green white green {
  ratio 67 267 66
}

charge ring red {
  radius 70
  inner 40
  at fly=300 hoist=220
}

charge svg {
  at center
  fly 600
  hoist 400
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400"><path d="M300 166a26 26 0 1 0-20.5-42M252.21 247.1a26 26 0 1 0-26.15 38.86m122.31-41.94a26 26 0 1 0 46.51 3.18" stroke-linecap="round" stroke-width="20" stroke="#d81e05" fill="none" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}
