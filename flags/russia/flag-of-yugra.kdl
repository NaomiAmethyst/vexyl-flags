// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Yugra"
  encoder "Threefolder"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Yugra.svg"
}
palette {
  green "#00971c"
  white "#ffffff"
  blue "#2e96ff"
}
proportion hoist=20 fly=40

bars green white {
  along hoist
  ratio 19 1
}

canton {
  fly 38
  hoist 10
  field blue
}

charge svg {
  at center
  fly 40
  hoist 20
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 20"><path d="M15,2 12,6 8,6 5,2 M12.5,2.25 10,5.65 7.5,2.25 M8.5,3.6 9.5,2.25 M11.5,3.6 10.5,2.25" stroke="#ffffff" fill="none" stroke-linecap="round" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}
