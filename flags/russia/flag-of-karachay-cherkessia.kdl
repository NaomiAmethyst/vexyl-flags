// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Karachay-Cherkessia"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Karachay-Cherkessia.svg"
}
palette {
  blue "#0090d0"
  green "#007030"
  red "#e02010"
  orange "#ffb000"
}
proportion hoist=300 fly=600

bars blue green red

charge disc orange {
  radius 20
  at fly=300 hoist=150
}

charge svg {
  at center
  fly 600
  hoist 300
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 300"><defs><clipPath id="mid"><circle cx="300" r="49" cy="150"></circle></clipPath></defs><path d="M 300,145 C 285,130 222,185 222,185 L 391,189 C 391,189 323,127 301,145 Z" clip-path="url(#mid)" fill="#ffffff" transform="matrix(1 0 0 1 0 0)"/><path d="M 301,162 C 281,144 263,178 241,166 C 252,216 366,221 356,164 C 338,166 321,139 301,162 Z" clip-path="url(#mid)" fill="#007030" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}

charge ring orange {
  radius 50
  inner 46
  at fly=300 hoist=150
}

charge svg {
  at center
  fly 600
  hoist 300
  markup #"""
