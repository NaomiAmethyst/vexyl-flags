// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Udmurtia"
  encoder "Fibonacci"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Udmurtia.svg"
}
palette {
  black "#000000"
  white "#ffffff"
  red "#dd2211"
}
proportion hoist=270 fly=540

bars black white red {
  along hoist
}

charge polygon red {
  point fly=245 hoist=60
  point fly=345 hoist=160
  point fly=195 hoist=160
  point fly=295 hoist=60
  point fly=295 hoist=210
  point fly=195 hoist=110
  point fly=345 hoist=110
  point fly=245 hoist=210
}
