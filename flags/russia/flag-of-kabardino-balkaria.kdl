// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Kabardino-Balkaria"
  encoder "Original: Unknown Vector: Conscious"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Kabardino-Balkaria.svg"
}
palette {
  blue "#3399ff"
  white "#ffffff"
  green "#00923f"
}
proportion hoist=300 fly=450

bars blue white green

charge disc blue {
  radius 50
  at fly=225 hoist=150
  anchor center
}

charge svg {
  at center
  fly 450
  hoist 300
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 450 300"><defs><clipPath id="mid"><circle cx="225" cy="150" r="50"></circle></clipPath></defs><path d="M 276,151 C 276,151 251,122 240,122 C 231,122 226,132 226,132 L 229,135 C 224,131 219,124 211,124 C 199,124 174,151 174,151 Z" clip-path="url(#mid)" stroke-width="1" stroke="#3399ff" stroke-linejoin="round" fill="#ffffff" transform="matrix(1 0 0 1 0 0)"/><rect height="50" x="175" width="100" y="150" clip-path="url(#mid)" fill="#00923f" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}
