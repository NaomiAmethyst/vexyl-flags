vexyl 1
meta {
  name "Flag of Ust-Orda Buryat Autonomous Okrug (07-1997)"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Ust-Orda_Buryat_Autonomous_Okrug_(07-1997).svg"
}
