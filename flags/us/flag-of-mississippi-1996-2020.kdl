// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Mississippi (1996–2020)"
  encoder "Rocky Vaughn, Sue Anna Joe, Dominique Pugh, Clay Moss, Kara Giles, and the Mississippi Department of Archives and Histor"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Mississippi_(1996%E2%80%932020).svg"
}
palette {
  pink "#bf0a30"
  white "#ffffff"
  blue "#00205b"
}
proportion hoist=738 fly=1107

field pink

