// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of the Philippines (1936–1985, 1986–1998)"
  encoder "Philippine Heraldry Committee"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_the_Philippines_(1936%E2%80%931985,_1986%E2%80%931998).svg"
}
palette {
  blue "#041e42"
  pink "#bf0d3e"
  white "#ffffff"
  yellow "#ffcd00"
}
proportion hoist=90 fly=180

charge polygon blue {
  point fly=0 hoist=0
  point fly=180 hoist=0
  point fly=180 hoist=45
  point fly=28 hoist=89
}

charge polygon pink {
  point fly=28 hoist=45
  point fly=180 hoist=45
  point fly=180 hoist=90
  point fly=0 hoist=90
}

chevrons white {
  depth 77.942
}

charge disc yellow {
  radius 9
  at fly=28 hoist=45
}

