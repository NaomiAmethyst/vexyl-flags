// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Hawaii (1816)"
  encoder "Own work"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Hawaii_(1816).svg"
}
palette {
  blue "#012169"
  white "#ffffff"
  red "#c8102e"
}
proportion hoist=60 fly=120

field blue

charge svg {
  at center
  fly 120
  hoist 60
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 60"><defs><clipPath id="c2"><path d="m 0,0 v 16.666667 h 60 v 16.666666 0 z m 0,33.333333 v 0 H 30 V 0 h 30 z"></path></clipPath><clipPath id="c1"><path d="M 0,0 H 65 V 33.333333 H 0 Z"></path></clipPath></defs><path d="M 0,0 60,33.333333 M 60,0 0,33.333333" stroke="#ffffff" stroke-width="6.66666666666667" clip-path="url(#c1)" transform="matrix(1 0 0 1 0 0)"/><path d="M 0,0 60,33.333333 M 60,0 0,33.333333" stroke="#c8102e" stroke-width="4.444444444444447" clip-path="url(#c2)" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}

charge rect white {
  fly 60
  hoist 11.1111
  at fly=30 hoist=16.6667
}

charge rect white {
  fly 11.1111
  hoist 33.3333
  at fly=30 hoist=16.6667
}

charge rect red {
  fly 60
  hoist 6.6667
  at fly=30 hoist=16.6667
}

charge rect red {
  fly 6.6667
  hoist 33.3333
  at fly=30 hoist=16.6667
}

charge rect red {
  fly 120
  hoist 6.6667
  at fly=60 hoist=43.3333
}

charge rect white {
  fly 120
  hoist 6.6667
  at fly=60 hoist=50
}

charge rect red {
  fly 60
  hoist 6.6667
  at fly=90 hoist=23.3333
}

charge rect white {
  fly 60
  hoist 6.6667
  at fly=90 hoist=30
}

panel {
  corner upper-fly
  fly 60
  hoist 6.6667
  field red
}

charge rect white {
  fly 60
  hoist 6.6667
  at fly=90 hoist=10
}
