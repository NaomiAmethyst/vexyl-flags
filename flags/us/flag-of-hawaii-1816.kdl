palette {
  blue "#012169"
  white "#ffffff"
  red "#c8102e"
}
proportion hoist=54 fly=108

field blue

canton {
  fly 54
  hoist 30
  saltire white {
    width 6
  }
  saltire red {
    width 2
    counterchange
  }
  cross red {
    fly 24 6 24
    hoist 12 6 12
    fimbriate white 2
  }
}

