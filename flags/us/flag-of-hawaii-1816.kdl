  fly 108
  hoist 6
  at fly=54 hoist=39
}

charge rect white {
  fly 108
  hoist 6
  at fly=54 hoist=45
}

charge rect red {
  fly 54
  hoist 6
  at fly=81 hoist=21
}

charge rect white {
  fly 54
  hoist 6
  at fly=81 hoist=27
}

