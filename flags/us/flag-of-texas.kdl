// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Texas"
  encoder "Paul B. Joiner"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Texas.svg"
}
palette {
  white "#ffffff"
  pink "#bf0a30"
  blue "#00205b"
}
proportion hoist=600 fly=900

bars white pink

panel {
  side hoist
  width 300
  field blue
}

charge svg {
  at center
  fly 900
  hoist 600
  markup #"""
