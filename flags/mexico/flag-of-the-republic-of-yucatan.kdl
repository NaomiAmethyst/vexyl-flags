// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of the Republic of Yucatan"
  encoder "TownDown"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_the_Republic_of_Yucatan.svg"
}
palette {
  red "#ce1126"
  white "#ffffff"
  green "#006847"
}
proportion hoist=300 fly=600

bars red white red

panel {
  side hoist
  width 200
  field green
  charge star white {
    radius 27.5
    inner 10.45
    at fly=100 hoist=150
    at fly=40 hoist=50
    at fly=160 hoist=50
    at fly=40 hoist=250
    at fly=160 hoist=250
  }
}
