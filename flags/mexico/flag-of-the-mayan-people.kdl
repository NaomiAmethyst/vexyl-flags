vexyl 1
meta {
  name "Flag of the Mayan People"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_the_Mayan_People.svg" {
    author "Johannes Rössel (talk)"
    license "LicenseRef-Public-Domain"
  }
}
palette {
  blue "#0f47af"
  white "#ffffff"
  red "#e03940"
  yellow "#fcdd09"
}
proportion hoist=2 fly=3

pile blue {
  from top
  depth 1
}

chevrons white {
  depth 1.5
}

pile red {
  from bottom
  depth 1
}

pile yellow {
  from fly
  depth 1.5
}
