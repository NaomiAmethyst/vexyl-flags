// Drawn from its source by tools/svg2vexyl.py, and not checked against an official construction.
vexyl 1
meta {
  name "Flag of Montserrat (1960–1999)"
  encoder "Bringing It All Back Home"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Montserrat_(1960%E2%80%931999).svg"
}
palette {
  blue "#012169"
  white "#ffffff"
  red "#c8102e"
}
proportion hoist=30 fly=60

field blue

charge svg {
  at center
  fly 60
  hoist 30
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 500"><path d="" stroke-opacity="1" stroke-linejoin="miter" fill-rule="evenodd" stroke-width="1.20835123pt" fill-opacity="1" fill="none" stroke="#000000" stroke-linecap="round" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}

