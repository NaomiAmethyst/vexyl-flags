  point fly=0 hoist=0
  point fly=0 hoist=1.6771
  point fly=26.65 hoist=15
  point fly=30 hoist=15
  point fly=30 hoist=13.323
  point fly=3.35 hoist=0
}

charge polygon white {
  point fly=30 hoist=0
  point fly=30 hoist=1.677
  point fly=3.35 hoist=15
  point fly=0 hoist=15
  point fly=0 hoist=13.3229
  point fly=26.65 hoist=0
}

charge rect white {
  fly 5
  hoist 15
  at fly=15 hoist=7.5
}

charge rect white {
  fly 30
  hoist 5
  at fly=15 hoist=7.5
}

charge rect red {
  fly 30
  hoist 3
  at fly=15 hoist=7.5
}

charge rect red {
  fly 3
  hoist 15
  at fly=15 hoist=7.5
}

