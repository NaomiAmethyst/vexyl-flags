// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of East Timor (3-2)"
  encoder "Sangjinhwa"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_East_Timor_(3-2).svg"
}
palette {
  red "#dc241f"
  orange "#ffc726"
  black "#000000"
}
proportion hoist=12 fly=18

field red

chevrons orange {
  depth 9
}

chevrons black {
  depth 6
}

charge svg {
  at center
  fly 18
  hoist 12
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 12"><path d="M0-2.1l-.65 2L.3.2z" fill="#ffffff" transform="matrix(0.671 -0.335 0.335 0.671 2.25 6)"/><path d="M0-2.1l-.65 2L.3.2z" fill="#ffffff" transform="matrix(-0.671 0.335 0.335 0.671 2.25 6)"/><path d="M0-2.1l-.65 2L.3.2z" fill="#ffffff" transform="matrix(0.525954 0.534638 -0.534638 0.525954 2.25 6)"/><path d="M0-2.1l-.65 2L.3.2z" fill="#ffffff" transform="matrix(-0.525954 -0.534638 -0.534638 0.525954 2.25 6)"/><path d="M0-2.1l-.65 2L.3.2z" fill="#ffffff" transform="matrix(-0.111254 -0.74168 0.74168 -0.111254 2.25 6)"/><path d="M0-2.1l-.65 2L.3.2z" fill="#ffffff" transform="matrix(0.111254 0.74168 0.74168 -0.111254 2.25 6)"/><path d="M0-2.1l-.65 2L.3.2z" fill="#ffffff" transform="matrix(-0.345859 0.665563 -0.665563 -0.345859 2.25 6)"/><path d="M0-2.1l-.65 2L.3.2z" fill="#ffffff" transform="matrix(0.345859 -0.665563 -0.665563 -0.345859 2.25 6)"/><path d="M0-2.1l-.65 2L.3.2z" fill="#ffffff" transform="matrix(-0.739864 -0.123261 0.123261 -0.739864 2.25 6)"/><path d="M0-2.1l-.65 2L.3.2z" fill="#ffffff" transform="matrix(0.739864 0.123261 0.123261 -0.739864 2.25 6)"/></svg>
"""#
