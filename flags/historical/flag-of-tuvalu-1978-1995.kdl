vexyl 1
meta {
  name "Flag of Tuvalu (1978–1995)"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Tuvalu_(1978%E2%80%931995).svg" {
    author "Thommy"
    license "LicenseRef-Public-Domain"
  }
}
palette {
  blue "#012169"
  white "#ffffff"
  red "#c8102e"
}
proportion hoist=60 fly=120

field blue

canton {
  fly 60
  hoist 30
  saltire white {
    width 6
  }
  saltire red {
    width 2
    counterchange
  }
  cross red {
    fly 27 6 27
    hoist 12 6 12
    fimbriate white 2
  }
}

