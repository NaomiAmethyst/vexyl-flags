// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Hatay"
  encoder "A. Özgür Erdemli"
  license "CC-BY-SA-3.0"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Hatay.svg"
}
palette {
  red "#e30a17"
  white "#ffffff"
}
proportion hoist=80 fly=120

field red

charge disc white {
  radius 20
  at fly=40 hoist=40
}

charge disc red {
  radius 16
  at fly=45 hoist=40
}

charge svg {
  at center
  fly 120
  hoist 80
