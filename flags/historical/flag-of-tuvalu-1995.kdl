// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Tuvalu (1995)"
  encoder "Thommy"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Tuvalu_(1995).svg"
}
palette {
  blue "#012169"
  white "#ffffff"
  red "#c8102e"
}
proportion hoist=600 fly=1200

field blue

charge svg {
  at center
  fly 1200
  hoist 600
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600"><defs><clipPath id="c2"><path d="m0 0v150h700v150h-100zm0 300v50h300v-350h300z"></path></clipPath><clipPath id="c1"><path d="m0 0h650v350h0-650z"></path></clipPath></defs><path d="m0 0 600 300m0-300-600 300" stroke="#ffffff" stroke-width="60" clip-path="url(#c1)" transform="matrix(1 0 0 1 0 0)"/><path d="m0 0 600 300m0-300-600 300" stroke="#c8102e" stroke-width="40" clip-path="url(#c2)" transform="matrix(1 0 0 1 0 0)"/></svg>
"""#
}

charge rect white {
  fly 700
  hoist 100
  at fly=350 hoist=150
}

charge rect white {
  fly 100
  hoist 350
  at fly=300 hoist=175
}

charge rect red {
  fly 700
  hoist 60
  at fly=350 hoist=150
}

charge rect red {
  fly 60
  hoist 350
  at fly=300 hoist=175
}

