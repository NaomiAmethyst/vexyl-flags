// Drawn from its source by tools/svg2vexyl.py, and not checked against an official construction.
vexyl 1
meta {
  name "Flag of the United States"
  encoder "Uploaded by Dbenbenn; edited by users such as Zscout370, Jacobolus, Indolences, and Technion."
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_the_United_States.svg"
}
palette {
  red "#b31942"
  white "#ffffff"
  blue "#0a3161"
}
proportion hoist=600 fly=1140

field red

charge rect white {
  fly 1140
  hoist 46
  at fly=570 hoist=69.25
  repeat line count=6 hoist=92.25
}

canton {
  fly 456
  hoist 323
  field blue
  charge star white {
    radius 18.5
    repeat grid rows=9 columns=11 stagger=#true
  }
}
