// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Sinoe County"
  encoder "Original: Presidentially-appointed Sinoe County flag committee Vector: Fry1989"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Sinoe_County.svg"
}
palette {
  white "#ffffff"
  pink "#bf0a30"
  blue "#002868"
  green "#006633"
}
proportion hoist=2400 fly=4000

field white

canton {
  fly 1000
  hoist 600
  field pink
  charge rect white {
    fly 1000
    hoist 54.5455
    at fly=500 hoist=81.8182
    repeat line count=5 hoist=109.0909
  }
}

canton {
  fly 272.7273
  hoist 272.7273
  field blue
}

charge svg {
  at center
  fly 4000
  hoist 2400
  markup #"""
