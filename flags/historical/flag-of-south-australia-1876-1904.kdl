// Drawn from its source by tools/svg2vexyl.py, and not checked against an official construction.
vexyl 1
meta {
  name "Flag of South Australia (1876–1904)"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_South_Australia_(1876%E2%80%931904).svg" {
    author "Tsange"
    license "CC-BY-SA-4.0"
  }
}
palette {
  blue "#00247d"
  white "#ffffff"
  red "#cf142b"
  light-blue "#87cefa"
}
proportion hoist=60 fly=120

field blue

canton {
  fly 60
  hoist 30
  saltire white {
    width 6
  }
  saltire red {
    width 2
    counterchange
  }
  cross red {
    fly 27 6 27
    hoist 12 6 12
    fimbriate white 2
  }
}

charge polygon blue {
  point fly=0 hoist=30
  point fly=60 hoist=30
  point fly=60 hoist=0
  point fly=120 hoist=0
  point fly=120 hoist=60
  point fly=0 hoist=60
}

charge disc light-blue {
  radius 14.9375
  at fly=90 hoist=30
}

charge svg {
  at center
  fly 120
  hoist 60
  markup #"""
