// Drawn from its source by tools/svg2vexyl.py, and not checked against an official construction.
vexyl 1
meta {
  name "Flag of Queensland (1870–1876)"
  encoder "Tsange"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Queensland_(1870%E2%80%931876).svg"
}
palette {
  blue "#00247d"
  white "#ffffff"
  red "#cf142b"
}
proportion hoist=60 fly=120

field blue

canton {
  fly 60
  hoist 30
  saltire white {
    width 6
  }
  saltire red {
    width 2
    counterchange
  }
  cross red {
    fly 27 6 27
    hoist 12 6 12
    fimbriate white 2
  }
}

charge polygon blue {
  point fly=0 hoist=30
  point fly=60 hoist=30
  point fly=60 hoist=0
  point fly=120 hoist=0
  point fly=120 hoist=60
  point fly=0 hoist=60
}

charge disc white {
  radius 13.3125
  at fly=90 hoist=30
}

charge svg {
  at center
  fly 120
  hoist 60
