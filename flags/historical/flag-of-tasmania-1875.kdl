// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Tasmania (1875)"
  encoder "Tsange"
  license "CC-BY-SA-4.0"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Tasmania_(1875).svg"
}
palette {
  white "#ffffff"
  blue "#00247d"
}
proportion hoist=15 fly=30

canton {
  fly 15
  hoist 7.5
  field white
}

field blue

charge svg {
  at center
  fly 30
  hoist 15
  markup #"""
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 15"><defs><clipPath id="border"><rect width="30" height="15" x="-15" y="-7.5"></rect></clipPath></defs><g clip-path="url(#border)" transform="matrix(0.475 0 0 0.45 7.125 3.375)"><circle r="20" cx="0" cy="0" fill="#00247d"></circle><path d="M -20,-10 L 20,10 M -20,10 L 20,-10" stroke="#ffffff" stroke-width="3"></path><path d="M -20,-10 L 20,10 M -20,10 L 20,-10" stroke="#cf142b" stroke-width="2"></path><path d="M 0,0 L 20,10 L 17,10 L -3,0 M 0,0 L 20,-10 L 23,-10 L 3,0 M 0,0 L -20,10 L -23,10 L -3,0 M 0,0 L -20,-10 L -17,-10 L 3,0" stroke="none" fill="#ffffff"></path><path d="M -20,0 L 20,0 M 0,-10 L 0,10" stroke="#ffffff" stroke-width="5"></path><path d="M -20,0 L 20,0 M 0,-10 L 0,10" stroke="#cf142b" stroke-width="3"></path></g></svg>
"""#
}

