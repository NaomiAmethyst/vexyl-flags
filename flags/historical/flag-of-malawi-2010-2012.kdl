    author "Fornax, Zscout370, Phlegmatic"
    license "LicenseRef-Public-Domain"
  }
}
palette {
  red "#ce1126"
  black "#000000"
  green "#339e35"
  white "#ffffff"
}
proportion hoist=2 fly=3

bars red black green

charge disc white {
  radius 0.2667
  at center
}

