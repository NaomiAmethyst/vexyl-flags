// Drawn from its source by tools/svg2vexyl.py, and not checked against an official construction.
vexyl 1
meta {
  name "Flag of the Kingdom of Bau"
  encoder "Jeromi Mikhael, crown and sun by Jaume Ollé."
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_the_Kingdom_of_Bau.svg"
}
palette {
  white "#ffffff"
  purple "#4000c7"
  yellow "#f1d13b"
  red "#ff0000"
}
proportion hoist=1 fly=1.4925

bars white purple {
  ratio 1 2
}

