vexyl 1
meta {
  name "Flag of the British Windward Islands (1953-1958)"
  encoder "Thommy"
  license "CC0-1.0"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_the_British_Windward_Islands_(1953%E2%80%931958).svg"
}
palette {
  blue "#012169"
  white "#ffffff"
  red "#c8102e"
}
proportion hoist=60 fly=120

field blue

canton {
  fly 60
  hoist 30
  saltire white {
    width 6
  }
  saltire red {
    width 2
    counterchange
  }
  cross red {
    fly 27 6 27
    hoist 12 6 12
    fimbriate white 2
  }
}

