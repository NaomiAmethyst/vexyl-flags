// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Grand Kru County"
  encoder "Fry1989"
  license "CC-BY-SA-3.0"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Grand_Kru_County.svg"
}
palette {
  green "#006633"
  yellow "#fad115"
  white "#ffffff"
  pink "#bf0a30"
  blue "#002868"
}
proportion hoist=2400 fly=4000

bars green yellow white green yellow white green {
  along hoist
  ratio 1 1 1 1 1 14 1
}

canton {
  fly 1000
  hoist 600
  field pink
  charge rect white {
    fly 1000.1
    hoist 54.5455
    at fly=500.05 hoist=81.8182
    repeat line count=4 hoist=109.0909
  }
  charge rect white {
    fly 1000.1
    hoist 54.5454
    at fly=500.05 hoist=518.1818
  }
}

canton {
  fly 272.7273
  hoist 272.7273
  field blue
}

charge svg {
  at center
  fly 4000
  hoist 2400
  markup #"""
