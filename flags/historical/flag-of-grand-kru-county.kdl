"""#
}

charge rect yellow {
  fly 200
  hoist 2400
  at fly=3700 hoist=1200
}

charge rect green {
  fly 201
  hoist 2400
  at fly=3299.5 hoist=1200
}

charge rect yellow {
  fly 200
  hoist 2400
  at fly=3100 hoist=1200
}

