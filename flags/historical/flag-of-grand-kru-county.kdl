// Drawn from its source by tools/svg2vexyl.py, and not checked against an official construction.
vexyl 1
meta {
  name "Flag of Grand Kru County"
  encoder "Fry1989"
  license "CC-BY-SA-3.0"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Grand_Kru_County.svg"
}
palette {
  green "#006633"
  yellow "#fad115"
  white "#ffffff"
  red "#bf0a30"
  blue "#002868"
}
proportion hoist=3 fly=5

bars green yellow white green yellow white green {
  along hoist
  ratio 1 1 1 1 1 14 1
}

canton {
  fly 1.25
  hoist 0.75
  field red
  charge rect white {
    fly 1.25
    hoist 0.0682
    at fly=0.625 hoist=0.1023
    repeat line count=4 hoist=0.1364
  }
  charge rect white {
    fly 1.25
    hoist 0.0682
    at fly=0.625 hoist=0.6477
  }
}

canton {
  fly 0.3409
  hoist 0.3409
  field blue
  charge star white {
    radius 0.1023
    at center
  }
}

charge rect yellow {
  fly 0.25
  hoist 3
  at fly=4.625 hoist=1.5
}

charge rect green {
  fly 0.2512
  hoist 3
  at fly=4.125 hoist=1.5
}

charge rect yellow {
  fly 0.25
  hoist 3
  at fly=3.875 hoist=1.5
}

charge svg {
  at center
  fly 5
  hoist 3
  markup #"""
