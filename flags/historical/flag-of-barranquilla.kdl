// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Barranquilla"
  encoder "User:Fibonacci"
  license "CC-BY-SA-3.0"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Barranquilla.svg"
}
palette {
  red "#ce1126"
  yellow "#fcd116"
  green "#078930"
}
proportion hoist=216 fly=360

field red

charge rect yellow {
  fly 288
  hoist 144
  at fly=180 hoist=108
}

charge rect green {
  fly 216
  hoist 72
  at fly=180 hoist=108
}

