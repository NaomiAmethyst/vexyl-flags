// Drawn from its source by tools/svg2vexyl.py, and not checked against an official construction.
vexyl 1
meta {
  name "State Flag of Guatemala (1858-1871)"
  encoder "Germenfer"
  license "CC-BY-SA-4.0"
  source "https://commons.wikimedia.org/wiki/File:State_Flag_of_Guatemala_(1858-1871).svg"
}
palette {
  blue "#0f47af"
  white "#ffffff"
  red "#da121a"
  yellow "#fcdd09"
  dark-yellow "#d4aa00"
}
proportion hoist=1 fly=2

bars blue white red yellow red white blue {
  ratio 1 1 1 3 1 1 1
}

