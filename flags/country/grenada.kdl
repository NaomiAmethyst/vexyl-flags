// From the Album des Pavillons 2000's sheet as FOTW shows it: border 2, field 21 by 11, so
// 15 by 25. From the Commons drawing, scaled to this grid: the stars, disc and nutmeg.
vexyl 1
meta {
  name "Grenada"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Grenada.svg" {
    author "See the file's history on Commons"
    license "LicenseRef-Public-Domain"
    part "the nutmeg"
  }
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Grenada.svg"
  source "https://www.crwflags.com/fotw/flags/gd.html"
  source "https://www.gov.gd/index.php/national-symbols"
  source "https://flagmakers.co.uk/media/4k1gezzh/flag-of-grenada-a-brief-history-download.pdf"
  note "No law defining this flag was found or read. The proportion and border are not legal values: 3:5 and the sheet's border are the Album's, and the government's page gives 5:3 on land too."
  note "The government's page also gives 2:1 at sea, but with no law or construction behind it, so it isn't a variant here."
  note "Hex, Pantone and CMYK are the Album des Pavillons 2023's, as FOTW reports them. The London 2012 manual gives Pantone 032, 109 and 355 instead."
  note "The nutmeg's drawing comes from the Commons file and isn't from a law."
}
palette {
  red "#c8102e" {
    pantone "186 C"
    cmyk 14 100 79 4
  }
  green "#007856" {
    pantone "341 C"
    cmyk 87 28 74 14
  }
  yellow "#ffcc00" {
    pantone "116 C"
    cmyk 0 21 93 0
  }
}
proportion hoist=15 fly=25

define shell {
  path "M67.944 150.113c4.262 8.515 12.757 17.893 20.313 21.321.367-8.513-2.341-19.515-6.224-28.33z" box="50 110 60 70"
}
define nutmeg {
  path "M60.284 121.487c6.35 13.695-17.533 45.856 21.453 53.976-4.736-6.643-7.33-17.752-6.04-26.456 8.095 3.448 16.212 11.464 19.402 18.972 13.444-37.484-26.456-33.922-34.815-46.492z" box="50 110 60 70"
}

field red
panel {
  fly 21
  hoist 11
  quarters yellow green yellow green {
    diagonal
  }
}
charge disc red {
  radius 1.8
}
charge star yellow {
  radius 1.65
}
charge shell red {
  fly 3
  hoist 3.5
  at fly=4 hoist=7.25
}
charge nutmeg yellow {
  fly 3
  hoist 3.5
  at fly=4 hoist=7.25
}
charge star yellow {
  radius 0.975
  at fly=7.5 hoist=14
  at fly=12.5 hoist=14
  at fly=17.5 hoist=14
  at fly=7.5 hoist=1
  at fly=12.5 hoist=1
  at fly=17.5 hoist=1
}
