// From the law, Article 2, on a length of 60, so a width of 40:
//   white circle diameter 1/3 of the length, radius 10, centered on the diagonals
//   star center 1/30 of the length toward the fly, so 2 from the flag's center
//   star points on a circle 15% of the length across, radius 4.5, one point on the
//     horizontal median and toward the hoist, so rotate -90
//   crescent outer arc diameter 1/4 of the length, radius 7.5, centered on the circle
//   crescent inner arc diameter 1/5 of the length, radius 6, centered on the star
vexyl 1
meta {
  name "Tunisia"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://web.archive.org/web/20210128003842/http://www.legislation.tn/sites/default/files/fraction-journal-officiel/1999/1999F/054/TF1999571.pdf"
  source "https://www.constituteproject.org/constitution/Tunisia_2022"
  source "https://www.crwflags.com/fotw/flags/tn.html"
  note "Article 4 attaches a technical file with the color specifications, which isn't published with the law and wasn't read. The hex, Pantone and CMYK values are the Album des Pavillons 2023's, as reported by FOTW."
  law "Constitution of Tunisia, 2022, Article 8" {
    source "https://www.constituteproject.org/constitution/Tunisia_2022"
  }
  law "Organic Law No. 99-56 of 30 June 1999 on the flag of the Tunisian Republic" {
    source "https://web.archive.org/web/20210128003842/http://www.legislation.tn/sites/default/files/fraction-journal-officiel/1999/1999F/054/TF1999571.pdf"
  }
}
palette {
  red "#d21034" {
    pantone "186 C"
    cmyk 10 100 74 2
  }
  white "#ffffff"
}
proportion hoist=40 fly=60

field red
charge disc white {
  radius 10
  at center
}
charge crescent red {
  radius 7.5
  inner 6
  offset 2
  at center
}
charge star red {
  radius 4.5
  rotate -90
  at fly=32 hoist=20
}
