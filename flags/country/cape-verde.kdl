// From the Constitution: bands of 1/2, 1/12, 1/12, 1/12 and 1/4 of the height. The stars'
// center is at the middle of the second quarter on each axis, so 3/8 of the length and 3/8
// of the height from the bottom. The lowest star is on the lower blue band's median, so the
// ring's radius is 1/4 of the height.
// From the 2009 resolution's drawing: about 2:3, and stars measured at 0.045 of the height.
vexyl 1
meta {
  name "Cape Verde"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.constituteproject.org/constitution/Cape_Verde_1992"
  source "https://caboverde.eregulations.org/media/convencao%20de%20bucan.pdf"
  source "https://www.crwflags.com/fotw/flags/cv'.html"
  note "The Constitution fixes bands by their share of the flag's area, and gives no proportion and no star size. The 2:3 and the star size come from the drawing in the government's graphic manual, which isn't a law and draws about 0.68."
  note "The star's radius was measured from the manual's drawing at 400 dpi: the width and height of each star's bounding box, divided by 1.902 and 1.809."
  note "The manual draws the stars' center at about 0.362 of the length, and the Constitution's text gives 0.375, which this follows."
  note "The hex, Pantone and CMYK values are from the government's graphic manual, approved by Resolution 37/2009, not from the Constitution. That manual sets rules for government departments' use."
  law "Constitution of the Republic of Cape Verde, Article 8" {
    source "https://www.constituteproject.org/constitution/Cape_Verde_1992"
  }
}
palette {
  blue "#003893" {
    pantone "287 C"
    cmyk 100 89 8 2
  }
  white "#ffffff"
  red "#cf2027" {
    pantone "186 C"
    cmyk 12 100 100 3
  }
  yellow "#f7d116" {
    pantone "116 C"
    cmyk 4 15 98 0
  }
}
proportion hoist=12 fly=18

bars blue white red white blue {
  ratio 6 1 1 1 3
}
charge star yellow {
  radius 0.54
  at fly=6.75 hoist=7.5
  repeat ring count=10 radius=3
}
