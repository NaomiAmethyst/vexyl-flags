// From the Constitution: red over green, a five-pointed star of yellow-gold at the center.
// From Decree 97-457, as FOTW reports it: 2:3, with the star inside a circle of a third of
// the flag's width, so radius 1 on a hoist of 6.
vexyl 1
meta {
  name "Burkina Faso"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.constituteproject.org/constitution/Burkina_Faso_2015"
  source "https://crwflags.com/fotw/flags/bf'.html"
  note "Decree 97-457's sizes and Ordinance 84-043-CNR are known only through FOTW, whose contributor worked from copies. Their texts weren't read. The Grand Chancellery's 1996 letter, also through FOTW, says the circle around the star is centered on the flag."
  note "The Constitution names colors only. The hex, Pantone and CMYK values are the Album des Pavillons 2023, as reported by FOTW. The Album itself wasn't read."
  law "Constitution of 11 June 1991, Article 34" {
    source "https://www.constituteproject.org/constitution/Burkina_Faso_2015"
  }
  law "Ordinance No. 84-043-CNR of 4 August 1984, Article 5"
  law "Presidential Decree No. 97-457/PRES/GC of 30 October 1997, Article 1"
}
palette {
  red "#ef3340" {
    pantone "032 C"
    cmyk 0 89 68 0
  }
  green "#009530" {
    pantone "355 C"
    cmyk 84 12 100 1
  }
  yellow "#ffce00" {
    pantone "116 C"
    cmyk 0 19 93 0
  }
}
proportion hoist=6 fly=9

bars red green
charge star yellow {
  radius 1
  at center
}
