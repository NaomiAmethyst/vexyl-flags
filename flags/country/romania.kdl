// Article 1 and Annex 1: length L, width 2/3 L, each color 1/3 L.
// The hex values are the annex's RGB written in hexadecimal.
vexyl 1
meta {
  name "Romania"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://web.archive.org/web/20260626043910/https://legislatie.just.ro/Public/DetaliiDocument/4303"
  source "https://www.crwflags.com/fotw/flags/ro.html"
  note "The proportion, the stripes and the Pantone, CMYK and RGB values are all from Annex 1, as replaced by Law 176/2023, read in the Justice Ministry's consolidated text through a Wayback Machine snapshot."
  note "The order from the mast is Article 12 of the Constitution, known here from the quotation on FOTW. The Constitution's text wasn't read."
  law "Law No. 75/1994 on flying the flag of Romania, Article 1 and Annex 1, as amended by Law No. 176/2023" {
    source "https://web.archive.org/web/20260626043910/https://legislatie.just.ro/Public/DetaliiDocument/4303"
  }
  law "Constitution of Romania, Article 12"
  restriction "Article 1: no inscriptions or symbols may be added to the flag other than those approved by law or military regulations." {
    source "https://web.archive.org/web/20260626043910/https://legislatie.just.ro/Public/DetaliiDocument/4303"
  }
}
palette {
  blue "#002b7f" {
    pantone "280 C"
    cmyk 100 70 0 10
  }
  yellow "#fcd116" {
    pantone "116 C"
    cmyk 0 10 95 0
  }
  red "#ce1126" {
    pantone "186 C"
    cmyk 0 90 80 5
  }
}
proportion hoist=2 fly=3

bars blue yellow red {
  along hoist
}
