// From the law: Annex 1 of the flag law, as replaced by Royal Decree 99/2026, measured in
// its drawing in cm, times 3 here so that its thirds are whole:
//   350 x 200 cm, so 1050 x 600; the red hoist unit 116.67 = 350/3, so 350
//   white, red and green units of 66.67 = 200/3 each, so 200
//   emblem box: 10.67 from the top, 56 high, 53.48 wide, 31.60 and 31.59 from the panel's
//   edges, so 32.01, 168 and 160.44; its center is at 175.02 and 116.01 (derived)
// The emblem is traced from Annex 2 of Royal Decree 99/2026, and fills the law's box.
vexyl 1
meta {
  name "Oman"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://decree.om/2026/rd20260099/" {
    author "Government of the Sultanate of Oman"
    license "LicenseRef-Public-Domain"
    part "the national emblem, traced from Annex 2"
  }
  source "https://decree.om/2026/rd20260099/"
  source "https://decree.om/wp-content/uploads/2026/10/rd20260099-1.png"
  source "https://decree.om/wp-content/uploads/2026/10/rd20260099-2.png"
  source "https://qanoon.om/p/2026/rd2026099/"
  source "https://qanoon.om/p/2004/rd2004053/"
  source "https://www.crwflags.com/fotw/flags/om.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Oman.svg"
  source "https://qanoon.om/p/2008/rd2008065/"
  note "The emblem is traced from the line drawing in Annex 2 of Royal Decree 99/2026 (rd20260099-2.png, 1130 by 1226 pixels), not from the drawing on Wikimedia Commons. The annex's red lines were thresholded at half coverage and their outlines traced to a tenth of a pixel by marching squares, then simplified by Douglas-Peucker at 0.3 pixels; everything inside the outermost outline is filled white beneath them, so that the lines show in the flag's red as Annex 1 shows them. It fills the law's box, centered, keeping the drawing's proportions, which are within 0.03% of the box's."
  note "The emblem's drawing is treated as being in the public domain because Oman's Copyright Law (Royal Decree 65/2008), Article 4(a), excludes official documents such as laws and decrees from protection, and the drawing is an annex to a royal decree. That article ends by protecting such material where its compilation, arrangement or other intellectual effort is distinctive, and no court reading of that was found."
  note "National emblems are commonly restricted in use regardless of copyright, and the restriction below applies to the emblem as well as to the flag."
  note "The proportion, the red hoist third, the three equal horizontal units and the emblem's box are from Annex 1 as replaced by Royal Decree 99/2026, read as reproduced by decree.om (English) and qanoon.om (Arabic). The Official Gazette itself (No. 1672 of 1 November 2026) wasn't read."
  note "The law leaves colors and fabric to the competent entity, and none was found. The hex, Pantone and CMYK values are the Album des Pavillons 2023, as reported by FOTW; the Album itself wasn't read. The 2004 annex, now replaced, named the colors only as 'Banto - New ORM. C2X Red' and 'CNE 354 C2X - Green'. London 2012 used PMS 186 and 347, and Beijing 2008 PMS Warm Red and 354 C, as FOTW reports."
  note "The annex gives the emblem's width as 53.48 cm between its marks, which sum with the margins to the panel's 116.67, and as 53.43 cm in its legend. This uses 53.48."
  law "Royal Decree 53/2004 issuing the Law of the Flag, Emblem and National Anthem of the State" {
    source "https://qanoon.om/p/2004/rd2004053/"
  }
  law "Royal Decree 99/2026 amending some provisions of the Law of the Flag, Emblem and National Anthem of the State" {
    source "https://decree.om/2026/rd20260099/"
    source "https://decree.om/wp-content/uploads/2026/10/rd20260099-1.png"
    source "https://decree.om/wp-content/uploads/2026/10/rd20260099-2.png"
    source "https://qanoon.om/p/2026/rd2026099/"
  }
  restriction "Article 16, as replaced by Royal Decree 99/2026: deliberately desecrating the flag or the emblem, by lowering it, destroying it or any other act conveying hatred or contempt, is punishable by three months to three years in prison." {
    source "https://decree.om/2026/rd20260099/"
  }
}
palette {
  white "#ffffff"
  red "#e23828" {
    pantone "179 C"
    cmyk 3 88 88 0
  }
  green "#009530" {
    pantone "355 C"
    cmyk 84 12 100 1
  }
}
proportion hoist=600 fly=1050

bars white red green
panel {
  side hoist
  width 350
  field red
}
// The emblem: its silhouette in white, then the annex's lines in red, both traced from
// Annex 2 in the same box so that they register.
