// All of this grid is measured from the Commons drawing, because no law read gives sizes.
// Drawing on 600 by 800: the red band rises 480 over 800, so it's turned atan(0.6). It's
// centered on the flag, and 120 thick up the hoist, with 30 of yellow on each side. Scaled to
// 60 by 80, and perpendicular to the band: 12 x cos(30.9638) = 10.2899, and 3 x cos = 2.5725.
// The star: the drawing's isn't regular, so this is the regular star that overlaps it most
// when rendered over a range of sizes and centers, radius 119 centered at 146, 157 (scaled).
vexyl 1
meta {
  name "Democratic Republic of the Congo"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.wipo.int/wipolex/edocs/lexdocs/laws/fr/cd/cd008fr.pdf"
  source "https://www.crwflags.com/fotw/flags/cd.html"
  source "https://www.ambardc.de/symboles-nationaux"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_the_Democratic_Republic_of_the_Congo.svg"
  note "The constitution says only: a sky blue flag with a yellow star in the upper left corner, crossed on the slant by a red band finely framed in yellow. The embassy in Germany says the band starts from the upper right corner."
  note "The 3:4 proportion is reported by FOTW from the Presidency's and the embassy's pages. The Presidency's PDF couldn't be reached. FOTW reports 2:3 flags in use, at the 2008 Olympics for one."
  note "The band's width and the star's size and place are measured from the Commons drawing, and aren't legal. FOTW records different star sizes in use."
  note "The hex, Pantone and CMYK values are the Album des Pavillons 2025's, as reported by FOTW. The Album's 2023 blue, #007fff, is what Commons draws, but the 2025 blue is closer to the constitution's sky blue."
  law "Constitution of the Democratic Republic of the Congo of 18 February 2006, as revised in 2011, Article 1" {
    source "https://www.wipo.int/wipolex/edocs/lexdocs/laws/fr/cd/cd008fr.pdf"
  }
}
palette {
  blue "#41b6e6" {
    pantone "298 C"
    cmyk 67 7 3 0
  }
  yellow "#fbe122" {
    pantone "107 C"
    cmyk 5 6 89 0
  }
  red "#da291c" {
    pantone "485 C"
    cmyk 6 94 96 0
  }
}
proportion hoist=60 fly=80

field blue
band red {
  rotate -30.9638
  width 10.2899
  fimbriate yellow 2.5725
}
charge star yellow {
  radius 11.9
  at fly=14.6 hoist=15.7
}
