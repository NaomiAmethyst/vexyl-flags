  point fly=522.09 hoist=208.14
  point fly=442.86 hoist=305.46
  point fly=557.37 hoist=254.12
  point fly=455.66 hoist=327.61
  point fly=579.55 hoist=307.66
  point fly=462.28 hoist=352.32
  point fly=675.12 hoist=365.12
