// Length to width 3:2, with the hoist H = 96: taegeuk diameter H/2, each trigram H/4
// long and H/6 wide, set H/8 from the taegeuk with its center on a diagonal and its
// length across it. Bars are H/24 wide, with gaps and breaks of H/48.
//   Trigram center: 24 + 12 + 8 = 44. Bars at 38, 44 and 50, since 3 * 4 + 2 * 2 = 16.
vexyl 1
meta {
  name "South Korea"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.crwflags.com/fotw/flags/kr.html"
  note "From the law: the proportion, in Article 7 of the Act, the construction, in Article 6 of the decree, and the CIE and Munsell values, in the decree's Annex 2."
  note "Derived: the red and blue hex values were converted for this file from Annex 2's CIE values to sRGB, assuming D65, since the annex doesn't name an illuminant. Black and white are plain, and Annex 2 gives them only as Munsell values."
  note "From elsewhere: the Pantone values aren't in the law. FOTW reports them from a 1997 ministry document and from the Album des Pavillons."
  note "Article 5 of the decree lets the proportion differ at celebrations and along streets, with no figures, so this file has no variant for that."
  note "Amendments: the national law center's current texts are the Act as of 28 January 2014 (No. 12342) and the decree as of 26 July 2017 (No. 28211). Wikisource's 2014 decree has the same Article 6."
  law "National Flag Act (대한민국국기법), Article 7" {
    source "https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=150692"
  }
  law "Enforcement Decree of the National Flag Act (대한민국국기법 시행령), Articles 6 and 8 and Annex 2" {
    source "https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=195596"
    source "https://www.law.go.kr/LSW/flDownload.do?flSeq=30715691"
    source "https://ko.wikisource.org/wiki/%EB%8C%80%ED%95%9C%EB%AF%BC%EA%B5%AD%EA%B5%AD%EA%B8%B0%EB%B2%95_%EC%8B%9C%ED%96%89%EB%A0%B9"
  }
}
palette {
  white "#ffffff" {
    munsell "N 9.5"
  }
  red "#cd2e3a" {
    munsell "6.0R 4.5/14"
    pantone "186 C"
    reference "CIE xyY" "0.5640 0.3194 15.3"
  }
  blue "#0047a0" {
    munsell "5.0PB 3.0/12"
    pantone "294 C"
    reference "CIE xyY" "0.1556 0.1354 6.5"
  }
  black "#000000" {
    munsell "N 0.5"
  }
}
proportion hoist=96 fly=144

field white

emblem {
  along bend

  // The taegeuk: red above the diagonal and blue below, each swelling into the other.
  charge disc blue {
    radius 24
  }
  charge disc red {
    radius 24
    clip {
      rect {
        fly 48
        hoist 24
        at fly=0 hoist=-12
      }
    }
  }
  charge disc red {
    radius 12
    at fly=-12 hoist=0
  }
  charge disc blue {
    radius 12
    at fly=12 hoist=0
  }

  // Geon, upper hoist: three solid bars.
  charge rect black {
    fly 4
    hoist 24
    at fly=-50 hoist=0
    repeat line count=3 fly=6
  }

  // Gon, lower fly: three broken bars.
  charge rect black {
    fly 4
    hoist 24
    at fly=38 hoist=0
    repeat line count=3 fly=6
    cut {
      rect {
        fly 6
        hoist 2
        at fly=38 hoist=0
      }
    }
  }
}

emblem {
  along bend-sinister

  // Ri, lower hoist: solid, broken, solid.
  charge rect black {
    fly 4
    hoist 24
    at fly=-50 hoist=0
    repeat line count=2 fly=12
  }
  charge rect black {
    fly 4
    hoist 24
    at fly=-44 hoist=0
    cut {
      rect {
        fly 8
        hoist 2
        at fly=-44 hoist=0
      }
    }
  }

  // Gam, upper fly: broken, solid, broken.
  charge rect black {
    fly 4
    hoist 24
    at fly=44 hoist=0
  }
  charge rect black {
    fly 4
    hoist 24
    at fly=38 hoist=0
    repeat line count=2 fly=12
    cut {
      rect {
        fly 6
        hoist 2
        at fly=38 hoist=0
      }
    }
  }
}
