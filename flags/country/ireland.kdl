// Width twice the depth, and each color 1/3 of the width, with green next to the staff.
vexyl 1
meta {
  name "Ireland"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://www.irishstatutebook.ie/eli/cons/en/html"
  source "https://assets.gov.ie/static/documents/9d76c655/The_National_Flag_-_Guidelines_September_2025.pdf"
  source "https://www.crwflags.com/fotw/flags/ie.html"
  note "Article 7 of the Constitution names only the tricolour of green, white and orange."
  note "The proportion, the stripes, their order and Pantone 347 and 151 are from the government's guidelines of September 2025, which aren't law."
  note "The hex values and CMYK are the Album des Pavillons 2023, as reported by FOTW. The Album itself wasn't read."
  law "Constitution of Ireland, Article 7" {
    source "https://www.irishstatutebook.ie/eli/cons/en/html"
  }
}
palette {
  green "#169b62" {
    pantone "347"
    cmyk 81 12 76 1
  }
  white "#ffffff"
  orange "#f77f00" {
    pantone "151"
    cmyk 0 59 96 0
  }
}
proportion hoist=1 fly=2

bars green white orange {
  along hoist
}
