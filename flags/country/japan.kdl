// From Annex 1 of the law, on a hoist of 20:
//   hoist 2/3 of the fly, so a fly of 30
//   disc diameter 3/5 of the hoist, so a radius of 6, at the flag's center
// The provisional form in paragraph 3 of the supplementary provisions:
//   hoist 7/10 of the fly, so a fly of 200/7, or 28.5714
//   disc center 1/100 of the fly toward the staff, so 100/7 - 2/7 = 14 (derived here)
//   the disc's size is unchanged, because the paragraph alters only the two things above
vexyl 1
meta {
  name "Japan"
  date "1999-08-13"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://laws.e-gov.go.jp/api/1/lawdata/411AC0000000127"
  source "https://www.crwflags.com/fotw/flags/jp.html"
  source "https://en.wikipedia.org/wiki/Flag_of_Japan"
  note "The geometry and the colors white and beni-iro (crimson) are from the law, which gives no shade."
  note "The hex is what Wikipedia gives for the Munsell value below, using a color-analyzer tool, and it isn't legal. Pantone 186 C is the Album des Pavillons 2000, as reported by FOTW, and is a different shade. The Album wasn't read."
  note "A FOTW contributor reports a fabric sample suggesting Pantone 193 C instead."
  note "The Munsell value is the Defense Agency's specification DSP Z 8701C of 1973, as Wikipedia reports it. Wikipedia says a 2008 revision gives other values by fiber. The specification itself wasn't read."
  law "Act on National Flag and Anthem, Act No. 127 of 1999" {
    source "https://laws.e-gov.go.jp/api/1/lawdata/411AC0000000127"
  }
}
palette {
  white "#ffffff"
  red "#b0000f" {
    pantone "186 C"
    munsell "5R 4/12"
  }
}
proportion hoist=20 fly=30

field white
charge disc red {
  radius 6
  at center
}

// Paragraph 3 of the supplementary provisions allows this form for the time being.
variant provisional {
  proportion hoist=20 fly=28.5714
  field white
  charge disc red {
    radius 6
    at fly=14 hoist=10
  }
}
