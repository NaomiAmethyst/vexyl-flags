// Three equal horizontal stripes, yellow, green and red from the top, breadth to length 3:5.
vexyl 1
meta {
  name "Lithuania"
  date "2004-09-01"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://web.archive.org/web/20250115093644if_/https://e-seimas.lrs.lt/rs/actualedition/TAIS.1488/EBoiXMvKST/"
  source "https://www.crwflags.com/fotw/flags/lt.html"
  note "The geometry is Articles 2 and 3 of the law, as consolidated from 1 March 2024. The 3:5 dates from the version in force from 1 September 2004. Before that, the proportion was 1:2."
  note "The law requires a reference color image under the Pantone system, but gives no values. The Pantone, CMYK and hex are from a 2007 government document, as FOTW reports it. The document itself refused the download."
  law "Law on the State Flag and Other Flags of the Republic of Lithuania, No. I-1497" {
    source "https://web.archive.org/web/20250115093644if_/https://e-seimas.lrs.lt/rs/actualedition/TAIS.1488/EBoiXMvKST/"
  }
}
palette {
  yellow "#fdb913" {
    pantone "1235"
    cmyk 0 30 100 0
  }
  green "#006a44" {
    pantone "349"
    cmyk 100 55 100 0
  }
  red "#c1272d" {
    pantone "180"
    cmyk 25 100 100 0
  }
}
proportion hoist=3 fly=5

bars yellow green red
