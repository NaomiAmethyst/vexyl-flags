// From the law: three equal horizontal stripes, black, red, gold, 3:5. A banner has the same
// stripes running lengthwise, black on the left, with no proportion given.
vexyl 1
meta {
  name "Germany"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.gesetze-im-internet.de/gg/art_22.html"
  source "https://www.gesetze-im-internet.de/flaggano_1996/BJNR172900996.html"
  source "https://styleguide.bundesregierung.de/sg-de/basiselemente/farben"
  source "https://www.crwflags.com/fotw/flags/de_color.html"
  note "The geometry is from the 1996 order. The law names the colors only."
  note "Hex, CMYK and Pantone are the national colors in the federal government's style guide, which isn't a law and covers its branding. Its pure red #ff0000 doesn't resemble its own Pantone 485, so the red drawn here is the Commons drawing's #dd0000, which isn't legal or the style guide's. FOTW reports no Album des Pavillons values to use in its place, so the guide's are kept. FOTW reports RAL 3020 and 1028 from a 1998 letter from the interior ministry."
  note "The banner's transposed shape only records the stripes' direction, because the order fixes no proportion for it. The federal service flag, with the arms, is a separate flag."
  law "Basic Law for the Federal Republic of Germany, Article 22(2)" {
    source "https://www.gesetze-im-internet.de/gg/art_22.html"
  }
  law "Order on the German Flags of 13 November 1996, as amended 22 November 2005, section I no. 1" {
    source "https://www.gesetze-im-internet.de/flaggano_1996/BJNR172900996.html"
  }
}
palette {
  black "#000000" {
    pantone "Black"
    cmyk 0 0 0 100
    ral "9017"
  }
  red "#dd0000" {
    pantone "485"
    reference "Federal government style guide" "#ff0000"
    cmyk 0 100 100 0
    ral "3020"
  }
  gold "#ffcc00" {
    pantone "7405"
    cmyk 0 12 100 5
    ral "1028"
  }
}
proportion hoist=3 fly=5

bars black red gold

variant hanging {
  from transpose
}

// A generic way to fold a striped flag for storage, not any official procedure.
fold storage {
  description "In half lengthwise twice, then in half twice toward the hoist"
  under along=fly at=1.5 move=bottom
  under along=fly at=0.75 move=bottom
  over along=hoist at=2.5 move=fly
  over along=hoist at=1.25 move=fly
}
