palette {
  blue "#012169"
  white "#ffffff"
  red "#c8102e"
  yellow "#fedd00"
}
proportion hoist=60 fly=120

field blue

canton {
  fly 60
  hoist 30
  saltire white {
    width 6
  }
  saltire red {
    width 2
    counterchange
  }
  cross red {
    fly 27 6 27
    hoist 12 6 12
    fimbriate white 2
  }
}

charge polygon yellow {
  point fly=60 hoist=0
  point fly=120 hoist=0
  point fly=120 hoist=60
  point fly=0 hoist=60
  point fly=0 hoist=30
  point fly=60 hoist=30
}

charge disc blue {
  radius 5.1
  at fly=30 hoist=15
}

charge star yellow {
  radius 5.1
  at fly=30 hoist=15
}

charge star yellow {
  radius 3
  at fly=12.5 hoist=15.3
  at fly=47.5 hoist=15.3
  at fly=30 hoist=25.3
  at fly=30 hoist=5.3
}
