// From the law, the Flag Law of 11 April 1961, as quoted by FOTW and by G. de Graaf:
//   eleven stripes, alternating, first and last red
//   a square blue canton to the bottom of the third red stripe, so five stripes deep
//   the Port Flag of 10 by 19 feet, so 10:19, and with 11 stripes of 10 that's 110 by 209
//   a large star in the exact center of the canton (the law gives no size)
// From elsewhere: the star's enclosing circle is 2/3 of the canton, radius 50/3, the first
// of Christopher Southworth's readings on FOTW. It puts the star's two outer points about
// level with the top of the second red stripe. Hex, Pantone and CMYK are the Album des
// Pavillons 2023, as FOTW reports it.
vexyl 1
meta {
  name "Liberia"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.crwflags.com/fotw/flags/lr.html"
  source "https://fiav.org/wp-content/uploads/2021/03/ICV02-19.pdf"
  note "The Flag Law's own text wasn't read. Its Sections 30 to 32 are as Christopher Southworth quotes them on FOTW, and de Graaf's paper to the 2nd International Congress of Vexillology quotes the description and shades the same way."
  note "The law asks only for a large star. Its size here isn't legal: it's one of three readings on FOTW, chosen because the law puts the star in the exact center of the canton. Southworth's other readings are 3/4 of the canton, and 18/25 set slightly low as in BR20."
  note "The law's shades are navy blue, pure white and ruby red, with no numbers. The hex, Pantone and CMYK values are the Album des Pavillons 2023, as reported by FOTW. The Album wasn't read."
  law "Flag Law of the Republic of Liberia, approved 11 April 1961"
}
palette {
  red "#d21034" {
    pantone "186 C"
    cmyk 10 100 74 2
    reference "Flag Law of 1961" "ruby red"
  }
  white "#ffffff" {
    reference "Flag Law of 1961" "pure white"
  }
  blue "#003082" {
    pantone "288 C"
    cmyk 100 86 25 6
    reference "Flag Law of 1961" "navy blue"
  }
}
proportion hoist=110 fly=209

bars red white {
  count 11
}
canton {
  fly 50
  hoist 50
  field blue
  charge star white {
    radius 16.6667
  }
}
