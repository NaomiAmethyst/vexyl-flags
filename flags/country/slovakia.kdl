// From the law, section 7 and Annex 2's construction sheet:
//   2:3, three equal bands, here 200 each on a 600 by 900 grid
//   arms the same distance from the top, hoist and bottom, and half the height: 300 high,
//     from 150 to 450, starting 150 from the hoist
//   a white edge where the shield meets another color, 1/100 of the length: 9
// The shield's 240 width and its contents are from the drawing, not from the law's words.
vexyl 1
meta {
  name "Slovakia"
  designer "Ladislav Čisárik"
  designer "Ladislav Vrtel"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Slovakia.svg" {
    author "SKopp"
    license "LicenseRef-Public-Domain"
    part "the coat of arms"
  }
  source "https://web.archive.org/web/20230929145510id_/https://www.slov-lex.sk/static/pdf/1993/63/ZZ_1993_63_20190524.pdf"
  source "https://www.crwflags.com/fotw/flags/sk.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Slovakia.svg"
  note "The bands, proportion, and the arms' size, place and white edge are from section 7 and Annex 2 of the law, read in Slov-Lex's text in force from 24 May 2019."
  note "The law defines the arms in words and by its Annex 1 drawings. The shapes here come from the Commons file and aren't from the law."
  note "The law gives no shade. The hex, Pantone and CMYK values are the Album des Pavillons 2023's, as reported by FOTW, and the law's own drawing isn't a color specification."
  note "A bill amending this Act was announced for comment in August 2026, and its text wasn't read."
  law "Act No. 63/1993 Coll. on the state symbols of the Slovak Republic and their use, section 7 and Annex 2" {
    source "https://web.archive.org/web/20230929145510id_/https://www.slov-lex.sk/static/pdf/1993/63/ZZ_1993_63_20190524.pdf"
  }
}
palette {
  white "#ffffff"
  blue "#0035ad" {
    pantone "286 C"
    cmyk 99 80 0 0
  }
  red "#d21034" {
    pantone "186 C"
    cmyk 10 100 74 2
  }
}
proportion hoist=600 fly=900

bars white blue red
