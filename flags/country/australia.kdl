vexyl 1
meta {
  name "Australia"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Australia_(converted).svg"
  note "Rewritten by hand from the drawing on Commons, not a checked construction sheet."
}
palette {
  blue "#012169"
  white "#ffffff"
  red "#e4002b"
}
proportion hoist=5040 fly=10080

define union hoist=30 fly=60 {
  field blue
  saltire white {
    width 6
  }
  saltire red {
    width 2
    counterchange
  }
  cross red {
    fly 27 6 27
    hoist 12 6 12
    fimbriate white 2
  }
}

field blue
canton {
  fly 5040
  hoist 2520
  use union
}
charge star white {
  radius 756
  inner 336
  points 7
  at fly=2520 hoist=3780
}
charge star white {
  radius 360
  inner 160
  points 7
  at fly=7560 hoist=4200
  at fly=6300 hoist=2205
  at fly=7560 hoist=840
  at fly=8680 hoist=1869
}
