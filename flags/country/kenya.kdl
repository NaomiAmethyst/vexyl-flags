// From the law, the Second Schedule's dimensioned drawing, on its own grid of 30 by 20:
//   stripes 6, 1, 6, 1, 6, black, white, red, white, green
//   shield 12 high and 6 wide at the center, spears at 60 degrees crossing at the center
// The shield's and spears' artwork is the Commons drawing, which matches those sizes.
vexyl 1
meta {
  name "Kenya"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Kenya.svg" {
    author "User:Pumbaa80"
    license "LicenseRef-Public-Domain"
    part "the shield and spears"
  }
  source "http://www.parliament.go.ke/sites/default/files/2023-03/The_Constitution_of_Kenya_2010.pdf"
  source "https://www.crwflags.com/fotw/flags/ke.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Kenya.svg"
  note "The Second Schedule defines the emblem by an annexed drawing, whose dimensions the Commons artwork follows in its overall sizes and spear angle. The artwork isn't from the law, and it differs in one visible way: the Schedule's scan draws the central oval about 3 high and 1.5 wide, and labels 1 1/2, while Commons draws it 1.5 high and 1 wide."
  note "The Schedule gives British Standard shade references for red and green. The hex, Pantone and CMYK are the Album des Pavillons 2023 as FOTW reports it, not conversions of those shades. White and black are plain."
  law "Constitution of Kenya, 2010, Article 9 and Second Schedule" {
    source "http://www.parliament.go.ke/sites/default/files/2023-03/The_Constitution_of_Kenya_2010.pdf"
  }
}
palette {
  black "#000000"
  white "#ffffff"
  green "#007229" {
    pantone "356 C"
    cmyk 89 29 100 18
    reference "British Standard shade" "0-010"
  }
  red "#c0362c" {
    pantone "180 C"
    cmyk 18 89 85 7
    reference "British Standard shade" "0-006"
  }
}
proportion hoist=20 fly=30

bars black white red white green {
  ratio 6 1 6 1 6
}

