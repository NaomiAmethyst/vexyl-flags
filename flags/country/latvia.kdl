// From Article 1: red, white and red stripes in the ratio 2:1:2, width to length 1:2.
vexyl 1
meta {
  name "Latvia"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://likumi.lv/ta/id/200642-latvijas-valsts-karoga-likums"
  source "https://likumi.lv/doc.php?id=209092"
  source "https://www.vestnesis.lv/ta/id/190841"
  source "https://en.wikipedia.org/wiki/Flag_of_Latvia"
  note "The Pantone values are Cabinet Regulation No. 405: 19-1629 TPX or TC for cloth under point 18.1, and 201 C and White for images under points 19 to 21."
  note "The hex is Wikipedia's for Pantone 201 C, the law's color for images, and isn't a legal value. Wikipedia gives #77353d for the cloth color."
  law "Law on the National Flag of Latvia, 29 October 2009" {
    source "https://likumi.lv/ta/id/200642-latvijas-valsts-karoga-likums"
  }
  law "Cabinet of Ministers Regulation No. 405 of 27 April 2010, applying the Law on the National Flag of Latvia" {
    source "https://likumi.lv/doc.php?id=209092"
  }
}
palette {
  carmine "#9d2235" {
    pantone "201 C"
    reference "Pantone Textile, for cloth" "19-1629 TPX or 19-1629 TC"
  }
  white "#ffffff" {
    pantone "White"
  }
}
proportion hoist=1 fly=2

bars carmine white carmine {
  ratio 2 1 2
}
