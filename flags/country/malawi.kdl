// From the law, the First Schedule of the Protected Flag, Emblems and Names Act: three
// equal horizontal stripes of black, red and green, a red rising sun in the center of the
// black stripe, length to breadth 3:2. So 120 by 180 with stripes of 40.
// From elsewhere: the sun is the Commons file's, on a grid 0.4 of its own: a disc of radius
// 64.5 x 0.4, and rays 5 degrees apart, their outer ends 102 x 0.4 from the center, cut off
// 3 above the red stripe. The file's 32nd ray, at -80 degrees, lies wholly under the black
// and is left out, so 31 show. Hex, Pantone and CMYK are the Album des Pavillons 2023, as
// FOTW reports it.
vexyl 1
meta {
  name "Malawi"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Malawi.svg" {
    author "Achim1999"
    author "Unknown author (original)"
    license "LicenseRef-Public-Domain"
    part "the shape, size and place of the sun's disc and rays"
  }
  source "https://media.malawilii.org/files/legislation/akn-mw-act-1967-10-eng-2014-12-31.pdf"
  source "https://www.crwflags.com/fotw/flags/mw.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Malawi.svg"
  note "The law defines the sun's look only by the picture in its Schedule. The disc and rays here come from the Commons file Flag_of_Malawi.svg, not the law, with the file's shape of ray kept. The law's small picture also shows 31 rays, counted by sampling around the disc, but its sun is a little larger and higher."
  note "The law names the colors with no shades. The hex, Pantone and CMYK values are the Album des Pavillons 2023, as reported by FOTW, which lists them with no flag-specific color table. The Album wasn't read."
  law "Protected Flag, Emblems and Names Act, Chapter 18:03, as at 31 December 2014" {
    source "https://media.malawilii.org/files/legislation/akn-mw-act-1967-10-eng-2014-12-31.pdf"
  }
  restriction "Section 5: using a protected emblem or the protected colors for trade, advertising, or patent or trade mark titles needs the Minister's written permission. Section 4 makes insulting the flag an offence." {
    source "https://media.malawilii.org/files/legislation/akn-mw-act-1967-10-eng-2014-12-31.pdf"
  }
}
palette {
  black "#000000"
  red "#d21034" {
    pantone "186 C"
    cmyk 10 100 74 2
  }
  green "#289728" {
    pantone "362 C"
    cmyk 80 12 100 2
  }
}
proportion hoist=120 fly=180

field black
charge disc red {
  radius 25.8
  at fly=90 hoist=45.6
}
charge path red {
  d "m0 0c-2.16666 0-3 3.25-3 6.5 0 7.833332.95963 11.928508 3 23.5 2.04036-11.571492 3-15.666668 3-23.5 0-3.25-.83333-6.5-3-6.5z"
  box "-3 0 6 30"
  fly 2.4
  hoist 12
  at fly=90 hoist=45.6
  repeat arc count=31 radius=34.8 from=-75 to=75 turn=#true
}
panel {
  side bottom
  width 83
  field black
}
panel {
  side bottom
  width 80
  bars red green
}
