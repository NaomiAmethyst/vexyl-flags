// From the law: width to length 1 to 1.9, so 10 by 19. Flag width to star width 5 to 1, so a
// star 2 wide, and a five-point star's width is 1.902 x its radius, so radius 1.0515 (derived).
// From the drawing: the circle's radius, 3 here, and each star pointing outward.
vexyl 1
meta {
  name "Federated States of Micronesia"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.fsmlaw.org/fsm/code/title01/t01ch05.htm"
  source "https://mail.fsmlaw.org/fsm/code/code2014/pdf/FSMCode2014Tit01Chap05.pdf"
  source "https://www.crwflags.com/fotw/flags/fm.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_the_Federated_States_of_Micronesia.svg"
  note "The proportion, the star's width and the circle of four centered stars are from section 501. The law doesn't size the circle or turn the stars. Those two come from the Commons drawing, whose stars are a little narrower, at radius 1 here."
  note "The law says only blue, and FOTW finds no official shade. These are the Album des Pavillons 2023's values as FOTW reports them, much darker than the shades in other references listed here. FOTW notes the Album uses this blue for all the federation's flags."
  law "Code of the Federated States of Micronesia, Title 1, Chapter 5, section 501" {
    source "https://www.fsmlaw.org/fsm/code/title01/t01ch05.htm"
    source "https://mail.fsmlaw.org/fsm/code/code2014/pdf/FSMCode2014Tit01Chap05.pdf"
  }
}
palette {
  blue "#0035ad" {
    pantone "286 C"
    cmyk 99 80 0 0
    reference "Album des Pavillons 2000, Pantone" "292 C"
    reference "London 2012 manual, Pantone" "277"
  }
  white "#ffffff"
}
proportion hoist=10 fly=19

field blue
charge star white {
  radius 1.0515
  repeat ring count=4 radius=3 turn=#true
}
