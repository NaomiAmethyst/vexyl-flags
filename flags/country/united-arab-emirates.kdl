// From the guidelines' account of the law: width twice the height, a red section at the
// pole of the full height and a quarter of the width, and the rest in three equal
// horizontal sections, green, white and black.
vexyl 1
meta {
  name "United Arab Emirates"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://web.archive.org/web/20240602194113/https://u.ae/-/media/Documents-2nd-half-2023/NPO_UAEFLAG_Updated_12OCT23.pdf"
  source "https://web.archive.org/web/20260123014657/https://www.mohesr.gov.ae/Ar/MediaCenter/Documents/UAE%20Flag%20and%20Official%20Portraits%20Guideline_Updated_Nov.pdf"
  source "https://www.crwflags.com/fotw/flags/ae.html"
  note "The law's own text was blocked and wasn't read. Its terms are as restated by the government's United Arab Emirates Flag Guidelines of 2023, and the Flag and Official Portraits Guidelines say the same."
  note "The hex and Pantone values are the 2023 Guidelines', and the CMYK values are the Portraits Guidelines'. The Album des Pavillons 2023, as FOTW reports it, gives different colors: Pantone 187 C and 330 C."
  law "Federal Law No. 2 of 1971, as amended by Federal Decree-Law No. 13 of 2019" {
    source "https://web.archive.org/web/20240602194113/https://u.ae/-/media/Documents-2nd-half-2023/NPO_UAEFLAG_Updated_12OCT23.pdf"
  }
  restriction "Article 3: dropping, destroying or insulting the flag is punishable." {
    source "https://web.archive.org/web/20260123014657/https://www.mohesr.gov.ae/Ar/MediaCenter/Documents/UAE%20Flag%20and%20Official%20Portraits%20Guideline_Updated_Nov.pdf"
  }
}
palette {
  red "#c8102e" {
    pantone "186 C"
    cmyk 0 100 85 6
  }
  green "#00843d" {
    pantone "348 C"
    cmyk 96 2 100 12
  }
  white "#ffffff"
  black "#000000" {
    pantone "Black 6 C"
    cmyk 10 10 10 100
  }
}
proportion hoist=2 fly=4

bars green white black
panel {
  side hoist
  width 1
  field red
}
