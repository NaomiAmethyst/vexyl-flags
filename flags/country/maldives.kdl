// From the law, Article 12 and Schedule 3 of the Constitution of 2008, with width H = 480:
//   width 2/3 of the length, so the length is 720
//   red border H/4 = 120, leaving a green rectangle 480 by 240
//   both curves of the crescent have a radius of 1/3 of the rectangle's width, 80
//   their centers lie on its center line at 9/16 and 5/8 of its length from the staff
//   side, 270 and 300, so the offset is 30 and the crescent opens toward the fly
// From elsewhere: the law's colors are British Admiralty codes with no screen value.
// Hex, Pantone and CMYK are the Album des Pavillons 2023, as FOTW reports it.
vexyl 1
meta {
  name "Maldives"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://storage.googleapis.com/presidency.gov.mv/Documents/ConstitutionOfMaldives.pdf"
  source "https://web.archive.org/web/20090706135448/http://www.un.int/maldives/emble.htm"
  source "https://www.crwflags.com/fotw/flags/mv.html"
  note "Schedule 3 gives the border's width but not the rectangle's length, which follows if the border is even all round. The Maldives' UN mission states it: two-thirds of the flag's length."
  note "The law's colors are the British Admiralty codes kept here as references. The hex, Pantone and CMYK values are the Album des Pavillons 2023, as reported by FOTW, and aren't legal values. The Album wasn't read."
  law "Constitution of the Republic of Maldives 2008, Article 12 and Schedule 3" {
    source "https://storage.googleapis.com/presidency.gov.mv/Documents/ConstitutionOfMaldives.pdf"
  }
}
palette {
  red "#d21034" {
    pantone "186 C"
    cmyk 10 100 74 2
    reference "British Admiralty Colour Code, nylon worsted bunting" "T 1144"
    reference "British Admiralty Colour Code, other bunting" "T 818 A"
  }
  green "#007e3a" {
    pantone "348 C"
    cmyk 87 24 97 10
    reference "British Admiralty Colour Code, nylon worsted bunting" "T 1143"
    reference "British Admiralty Colour Code, other bunting" "T 817 A"
  }
  white "#ffffff" {
    reference "British Admiralty Colour Code, nylon worsted bunting" "T 1145"
    reference "British Admiralty Colour Code, other bunting" "T 819 A"
  }
}
proportion hoist=480 fly=720

field red
panel {
  fly 480
  hoist 240
  field green
  charge crescent white {
    radius 80
    inner 80
    offset 30
    at fly=270 hoist=120
  }
}
