// From the law: Law 33 of 1986 as replaced by Law 53 of 1987: the width is 2/3 of the
// length, in three equal horizontal rectangles, red, white, black. Law 9 of 2008, Article 2:
// the takbir in Kufic takes the middle third of the white rectangle along its length and
// its two middle quarters across. So on an 18 by 12 grid, a box of 6 by 2 at the center.
// The drawing's takbir fills it at 6 by 1.97.
vexyl 1
meta {
  name "Iraq"
  date "2008-02-05"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Iraq.svg" {
    author "Wikimedia Commons contributors, listed in the file's history"
    license "LicenseRef-Public-Domain"
    part "the takbir"
  }
  source "https://web.archive.org/web/20171014220349/http://www.iraqld.iq/LoadLawBook.aspx?page=1&SC=&BookID=28616"
  source "https://web.archive.org/web/20200404205318/https://www.iraqld.iq/LoadLawBook.aspx?page=1&SC=&BookID=10514"
  source "https://web.archive.org/web/20171014195426/http://www.iraqld.iq/LoadLawBook.aspx?page=1&SC=&BookID=14852"
  source "https://web.archive.org/web/20220213032158/https://protocol-pmo.gov.iq/the-countrys-flag/"
  source "https://www.crwflags.com/fotw/flags/iq.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Iraq.svg"
  note "Law 9 of 2008 says the size of the takbir, not its letterforms. Its drawing comes from the Commons file and isn't from the law. Commons draws it about 0.42 of the flag's length, larger than the third the law gives."
  note "Law 9 applies 'until a new Iraqi flag law is issued'. The legislation database marked it in force in the 2017 snapshot read, and no replacement was found. Law 6 of 1991 is known here only through Law 9's account of it."
  note "Law 33 puts the phrase on both faces, and the faces are identical, as FOTW also reports, so the writing reads correctly on the reverse."
  note "The law gives no shades. The colors are the Album des Pavillons 2023 as FOTW reports it. White and black are plain."
  note "Law 32 of 2009 is known only through the legislation database's footnote, which says it replaced Article 3 and removed its one-year limit. The database dates Law 9 to 5 February 2008, while it was approved on 29 January."
  law "Iraqi Flag Law No. 33 of 1986" {
    source "https://web.archive.org/web/20200404205318/https://www.iraqld.iq/LoadLawBook.aspx?page=1&SC=&BookID=10514"
  }
  law "Law No. 53 of 1987 amending the Iraqi Flag Law" {
    source "https://web.archive.org/web/20171014195426/http://www.iraqld.iq/LoadLawBook.aspx?page=1&SC=&BookID=14852"
  }
  law "Law No. 6 of 1991 amending the Iraqi Flag Law"
  law "Law No. 32 of 2009, first amendment to Law No. 9 of 2008"
  law "Law No. 9 of 2008 amending the Iraqi Flag Law, Al-Waqa'i Al-Iraqiya 4059, 5 February 2008" {
    source "https://web.archive.org/web/20171014220349/http://www.iraqld.iq/LoadLawBook.aspx?page=1&SC=&BookID=28616"
  }
}
