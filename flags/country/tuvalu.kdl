// From the law, on 60 by 120: the Union flag covers a quarter, so 30 by 60.
// A star's width is 1/12 of the flag's length, 10, so its radius is
// 10 / (2 sin 72) = 5.2573 (derived here). The union is the usual 30-unit one.
vexyl 1
meta {
  name "Tuvalu"
  date "1997-04-11"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Tuvalu.svg" {
    author "Wikimedia Commons contributors, listed in the file's history"
    license "LicenseRef-Public-Domain"
    part "the stars' positions and orientations"
  }
  source "https://web.archive.org/web/20250104014245/http://paclii.org/tv/legis/TV-consol_act_2008/tnfa212/"
  source "https://www.crwflags.com/fotw/flags/tv.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Tuvalu.svg"
  source "https://www.flaginstitute.org/wp/uk-flags/union-flag-specification/"
  note "Schedule 1 gives the azure blue field, nine yellow stars running diagonally on the right side from the top right corner, the Union flag at the upper left, 1:2, stars over half and the union over a quarter of the flag, and each star about 1/12 of the flag's width."
  note "Schedule 1 labels its 1:2 as width to height, and then sizes a star by the flag's width. Taken literally, that makes the stars half this size. This reads it as the flag's length, as the Commons drawing does, and that reading isn't confirmed by the law."
  note "Schedule 2 reproduces the flag, but the copy read doesn't include its image, and the law's text gives no star positions. The positions and which stars point down come from the Commons drawing. FOTW's contributor reports that Tuvalu's government picked Željko Heimer's image as correct, with no specification sheet."
  note "The law gives no shades. Hex, Pantone and CMYK are the Album des Pavillons 2023, as reported by FOTW. The union's construction isn't in the law. It's the Flag Institute's specification for the Union Flag, on the 1:2 form."
  note "This is the 2008 revised edition. A 2022 revised edition exists but couldn't be reached."
  law "Tuvalu National Flag Act, Cap. 4.40, as amended by Act 2 of 1997" {
    source "https://web.archive.org/web/20250104014245/http://paclii.org/tv/legis/TV-consol_act_2008/tnfa212/"
  }
}
palette {
  blue "#00267f" {
    pantone "280 C"
    cmyk 100 89 27 8
  }
  white "#ffffff"
  red "#d21034" {
    pantone "186 C"
    cmyk 10 100 74 2
  }
  sky "#6cabe7" {
    pantone "284 C"
    cmyk 59 23 0 0
  }
  gold "#ffce00" {
    pantone "116 C"
    cmyk 0 19 93 0
  }
}
proportion hoist=60 fly=120

define union hoist=30 fly=60 {
  field blue
  saltire white {
    width 6
  }
  saltire red {
    width 2
    counterchange
  }
  cross red {
    fly 27 6 27
    hoist 12 6 12
    fimbriate white 2
  }
}

field sky
canton {
  fly 60
  hoist 30
  use union
}
charge star gold {
  radius 5.2573
  at fly=65.5 hoist=54
  at fly=101 hoist=38.5
  at fly=111.5 hoist=8
  at fly=111.5 hoist=32
}
charge star gold {
  radius 5.2573
  rotate 180
  at fly=78 hoist=38.5
  at fly=78 hoist=51
  at fly=90.5 hoist=21.5
  at fly=90.5 hoist=47.5
  at fly=101 hoist=17.5
}
