// From the law, with a length of 30: black and white bands together 1/5 of the length,
// so 6, with each white band 1/6 of that, 1, and the black 4.
// Placement isn't in the law's numbers. As the government's drawing shows, the band's
// edge passes through the upper hoist corner, and it stays centered. So with a half-width
// of 3 from the center (15, 9): 15 sin a - 9 cos a = 3, a = 40.8386 degrees (derived here).
vexyl 1
meta {
  name "Trinidad and Tobago"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  design-rights "Section 3 of Chapter 19:04 vests the copyright in the design of the National Flag in the State in perpetuity."
  source "https://web.archive.org/web/20240718150804/https://agla.gov.tt/downloads/laws/19.04.pdf"
  source "https://laws.gov.tt/ttdll-web2/revision/download/43113?type=act"
  source "https://h.natt.gov.tt/sites/default/files/National%20Identity%20Guidelines.pdf"
  source "https://otp.tt/trinidad-and-tobago/national-emblems/"
  source "https://www.crwflags.com/fotw/flags/tt.html"
  note "The band's widths are Part II of the Schedule. The law doesn't state the proportion or the angle."
  note "5:3 is from the National Identity Guidelines and the Office of the President's page, not the law. Both give 2:1 for flags at sea, with no law for it, so that form isn't included here. The Guidelines' Figure 35a shows the placement used here."
  note "Red, white and black are named in the law. The hex, Pantone and CMYK are the Album des Pavillons 2023, as reported by FOTW, and FOTW's contributor found no legal shade."
  law "National Emblems of Trinidad and Tobago (Regulation) Act, Chapter 19:04" {
    source "https://web.archive.org/web/20240718150804/https://agla.gov.tt/downloads/laws/19.04.pdf"
    source "https://laws.gov.tt/ttdll-web2/revision/download/43113?type=act"
  }
  restriction "Section 7: it's an offence to mutilate or deface the flag, by writing, printing or stamping on it or otherwise, without lawful authority or excuse." {
    source "https://web.archive.org/web/20240718150804/https://agla.gov.tt/downloads/laws/19.04.pdf"
  }
}
palette {
  red "#d21034" {
    pantone "186 C"
    cmyk 10 100 74 2
  }
  white "#ffffff"
  black "#000000"
}
proportion hoist=18 fly=30

field red
band black {
  rotate 40.8386
  width 4
  fimbriate white 1
}
