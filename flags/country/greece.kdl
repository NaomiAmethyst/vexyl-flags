// Article 1: nine equal stripes, so 2 each on a grid of 18 by 27 (2:3).
// The canton is square, 5 stripes high, so 10. The cross's arm is one stripe wide, 2,
// and centered, so 2:1:2 each way (the centering follows from the equal-armed cross).
vexyl 1
meta {
  name "Greece"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://www.e-nomothesia.gr/kat-semaia/n-851-1978.html"
  source "https://www.crwflags.com/fotw/flags/gr_law.html"
  source "https://www.crwflags.com/fotw/flags/gr.html"
  source "https://en.wikipedia.org/wiki/Flag_of_Greece"
  note "The geometry and proportion are all from Article 1, read in Greek on e-nomothesia, with the table of sizes as a check. Article 1 calls the color kyanos, with no shade."
  note "The hex is from a 2010 government design guide for the national emblem, not for the flag, as Wikipedia reports it, along with its Pantone and CMYK. The guide wasn't read. The Album des Pavillons 2000 gives Pantone 286 C and CMYK 100 60 0 5, as reported by FOTW."
  note "White is plain white."
  law "Law No. 851/1978 on the National Flag, War Flags and the Insignia of the President of the Republic, Article 1" {
    source "https://www.e-nomothesia.gr/kat-semaia/n-851-1978.html"
  }
}
palette {
  blue "#014488" {
    pantone "280 C"
    cmyk 100 70 0 20
  }
  white "#ffffff"
}
proportion hoist=18 fly=27

bars blue white {
  count 9
}
canton {
  fly 10
  hoist 10
  field blue
  cross white {
    fly 2 1 2
    hoist 2 1 2
  }
}
