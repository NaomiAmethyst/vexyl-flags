// From the law, read in Chinese: the Instructions for Making the National Flag of 1949,
// which Article 2 of the National Flag Law applies, on the whole flag's grid: red, 3:2,
// the upper hoist quarter divided into 15 by 10.
//   large star center 5 from the hoist and 5 down, radius 3, one point straight up
//   small star centers (10, 2), (12, 4), (12, 7), (10, 9), radius 1
//   each small star has a point aimed at the large star's center, so each rotation
//   is atan2 of its offset to (5, 5) (the angles are derived here, not stated)
// From elsewhere: the law says red and yellow with no shade. The hex and the GB 12983-2004
// CIE values are Wikipedia's, and the standard itself wasn't read.
//
// Omitted: the white sleeve the Instructions give at the pole, outside the flag's face.
vexyl 1
meta {
  name "China"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.12371.cn/2021/05/23/ARTI1621736435095903.shtml"
  source "https://en.wikipedia.org/wiki/Flag_of_China"
  note "The law says only red and yellow. The hex values are those Wikipedia gives for the standard images on the National People's Congress site, and the CIE values are its account of GB 12983-2004. Neither was read directly."
  note "The Instructions also give the flag a white sleeve at the pole, which this omits."
  law "National Flag Law of the People's Republic of China, as amended 2020" {
    source "https://www.12371.cn/2021/05/23/ARTI1621736435095903.shtml"
  }
  law "Instructions for Making the National Flag, 28 September 1949" {
    source "https://www.12371.cn/2021/05/23/ARTI1621736435095903.shtml"
  }
  restriction "Article 20: the flag and its design may not be used in trademarks, patented designs or commercial advertising, at private funerals or in other unsuitable settings." {
    source "https://www.12371.cn/2021/05/23/ARTI1621736435095903.shtml"
  }
}
palette {
  red "#ee1c25" {
    reference "GB 12983-2004, CIE 1964 xyY10, D65" "0.595 0.328 9.2"
  }
  yellow "#ffff00" {
    reference "GB 12983-2004, CIE 1964 xyY10, D65" "0.467 0.463 33.0"
  }
}
proportion hoist=20 fly=30

field red
charge star yellow {
  radius 3
  at fly=5 hoist=5
}
charge star yellow {
  radius 1
  rotate -120.9638
  at fly=10 hoist=2
}
charge star yellow {
  radius 1
  rotate -98.1301
  at fly=12 hoist=4
}
charge star yellow {
  radius 1
  rotate -74.0546
  at fly=12 hoist=7
}
charge star yellow {
  radius 1
  rotate -51.3402
  at fly=10 hoist=9
}

// The Instructions: the stars on the two faces mirror each other.
reverse mirror
