// From the Constitution: three equal vertical bands with a star at the center of the middle one.
// From elsewhere: 2:3, and a star on a circle 2/3 of a band wide, so radius 1 on this grid.
vexyl 1
meta {
  name "Senegal"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://www.constituteproject.org/constitution/Senegal_2016"
  source "https://www.crwflags.com/fotw/flags/sn.html"
  note "The bands and star are from Article 1, read in the Constitute Project's English translation of the text as amended through 2016. It gives no proportion, star size or shades."
  note "The 2:3 proportion is what FOTW reports from most authors, and it says the proportion may be de facto rather than prescribed. The star's size is measured from FOTW's drawing. FOTW reports diameters from 1/3 to 2/3 of a band's width, and no source for one of them was found."
  note "The hex, Pantone and CMYK values are the Album des Pavillons 2023's, as reported by FOTW."
  law "Constitution of the Republic of Senegal, Article 1" {
    source "https://www.constituteproject.org/constitution/Senegal_2016"
  }
}
palette {
  green "#12ad2b" {
    pantone "361 C"
    cmyk 78 0 100 0
  }
  yellow "#ffce00" {
    pantone "116 C"
    cmyk 0 19 93 0
  }
  red "#d21034" {
    pantone "186 C"
    cmyk 10 100 74 2
  }
}
proportion hoist=6 fly=9

bars green yellow red {
  along hoist
}
charge star green {
  radius 1
  at center
}
