vexyl 1
meta {
  name "Flag of Senegal"
  encoder "Original upload by Nightstallion"
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Senegal.svg"
}
palette {
  yellow "#fdef42"
  red "#e31b23"
  green "#00853f"
}
