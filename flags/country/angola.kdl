// From the manual annexed to Presidential Decree 161/19: proportion 3:2, two equal
// horizontal stripes, the composition at the flag's center, with the lower side of the
// gear's fourth tooth from the top on the center line. The palette is the manual's.
// The gear and machete are the Commons paths. The star is written from the same drawing:
// its width of 0.3193 over 1.902 gives a radius of 0.1679, and its top at 0.5709 puts the
// center at 0.7388 (derived here from the drawing, not legal values).
vexyl 1
meta {
  name "Angola"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Angola.svg" {
    author "Henrique de Carvalho Santos (original)"
    author "SKopp (vector)"
    license "LicenseRef-Public-Domain"
    part "the gear, machete and star"
  }
  source "https://files.lex.ao/presidente-da-republica/2019/decreto-presidencial-n-o-161-19-de-20-de-maio/download/decreto-presidencial-n-o-161-19-de-20-de-maio_presidente-da-republica_lex-ao.pdf"
  source "https://lex.ao/docs/assembleia-nacional/2018/lei-n-o-14-18-de-29-de-outubro/"
  source "https://www.crwflags.com/fotw/flags/ao.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Angola.svg"
  note "The proportion, stripes, the emblem's reference point and all color values are the manual annexed to Presidential Decree 161/19. The manual gives black as RGB 30-30-30 with CMYK 0-0-0-100."
  note "The manual constructs the emblem on a drawn grid with no written sizes. The emblem's drawing comes from the Commons file, which isn't from the decree."
  note "The manual's own text calls the red bright and the yellow gold, while its Pantone and RGB show a darker red. Its values are recorded as printed."
  law "Presidential Decree No. 161/19 of 20 May 2019, approving the manual of technical specifications for the national symbols" {
    source "https://files.lex.ao/presidente-da-republica/2019/decreto-presidencial-n-o-161-19-de-20-de-maio/download/decreto-presidencial-n-o-161-19-de-20-de-maio_presidente-da-republica_lex-ao.pdf"
  }
  law "Law No. 14/18 of 29 October 2018 on deference to and use of the national symbols" {
    source "https://lex.ao/docs/assembleia-nacional/2018/lei-n-o-14-18-de-29-de-outubro/"
  }
}
palette {
  red "#c60c30" {
    pantone "186 C"
    cmyk 2 100 82 6
  }
  black "#1e1e1e" {
    pantone "Process Black C"
    cmyk 0 0 0 100
  }
  yellow "#fecb00" {
    pantone "116 C"
    cmyk 0 14 100 0
  }
}
proportion hoist=2 fly=3

bars red black
charge star yellow {
  radius 0.1679
  at fly=1.4625 hoist=0.7388
}
