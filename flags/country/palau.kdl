// From Public Law 7-6-2 as FOTW quotes it, not read directly, with the width as 10:
//   width to length 1.0 to 1.6; moon's diameter 0.6 of the width
//   moon's center 0.7 of the width from the mast side, and equally far from top and bottom
// From elsewhere: the law's colors are "golden yellow" and "sky blue", with no shade. The
// hex, Pantone and CMYK are the Album des Pavillons 2023's, as FOTW reports it.
vexyl 1
meta {
  name "Palau"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://www.crwflags.com/fotw/flags/pw.html"
  note "The text of Public Law No. 7-6-2 wasn't read. Its terms come from the passages FOTW's contributor quotes from it, and whether it has since been changed wasn't confirmed."
  note "FOTW's quotation adds that the flag may be reproduced for unofficial purposes with different dimensions."
  note "The law calls the colors golden yellow and sky blue. The Album des Pavillons 2023's values are used, as reported by FOTW, although its yellow is pale for a golden yellow. FOTW's CMYK for the blue, 100-89-34-21, doesn't fit the same entry's RGB, so it's left out."
  law "Public Law No. 7-6-2, To provide for the Flag of the Republic of Palau, approved 22 October 1980"
}
palette {
  blue "#00a0e2" {
    pantone "299 C"
  }
  yellow "#f5ec62" {
    pantone "101 C"
    cmyk 9 0 71 0
  }
}
proportion hoist=10 fly=16

field blue
charge disc yellow {
  radius 3
  at fly=7 hoist=5
}
