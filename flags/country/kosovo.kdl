// The law sets no construction: Article 3 of Law 03/L-038 leaves form, size and colors to
// the Assembly, and its determination wasn't found. The State Protocol law, No. 03/L-132,
// fixes sizes in the ratio 1:1.4, which is 5:7.
// From elsewhere: the map and the six stars' sizes and places are the Commons file, whose
// stars are symmetrical about the flag's center line. Colors come from FOTW and Wikipedia.
vexyl 1
meta {
  name "Kosovo"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Kosovo.svg" {
    author "Cradel (current version), earlier version by Ningyou"
    license "LicenseRef-Public-Domain"
    part "the map, and the stars' sizes and places"
  }
  source "https://www.ecoi.net/en/file/local/1110062/1504_1220512574_law-on-use-of-state-symbols-of-kosova.pdf"
  source "https://gjk-ks.org/wp-content/uploads/2017/11/gjkk_kushtetuta_e_republikes_se_kosoves_me_amendamentet_I-XXV_ang.pdf"
  source "https://web.archive.org/web/20170816235239id_/http://www.gazetazyrtare.com/e-gov/tr/index.php?option=com_content&task=view&id=351&Itemid=28"
  source "https://www.crwflags.com/fotw/flags/ks.html"
  source "https://en.wikipedia.org/wiki/Flag_of_Kosovo"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Kosovo.svg"
  note "None of these laws gives the flag's construction or colors, beyond the proportion. Wikipedia says that the colors and construction haven't been defined."
  note "The 1:1.4 proportion is from the State Protocol law, read in Albanian on an archived copy of gazetazyrtare.com, a site reproducing the gazette. Article 15 calls the flag's dimensions orientative and fixed in that ratio, while also suggesting 1.07 by 1.50 indoors and 16 by 23 cm on a table, which don't quite fit it. The design contest had asked for 2:3."
  note "The map's outline and the stars' sizes and places come from the Commons file Flag_of_Kosovo.svg, not any law. The file's rotations of under 0.1 degrees on the stars are dropped."
  note "The hex values are the ones Wikipedia calls the government's. They're the plain conversion of the CMYK that FOTW reports from the Album des Pavillons 2000 (corr. 5), kept here. FOTW also reports an unofficial correction from KosovaThanksYou, kept as a reference. The government's own PDF is gone, so this wasn't confirmed."
  law "Constitution of the Republic of Kosovo, Article 6" {
    source "https://gjk-ks.org/wp-content/uploads/2017/11/gjkk_kushtetuta_e_republikes_se_kosoves_me_amendamentet_I-XXV_ang.pdf"
  }
  law "Law No. 03/L-038 on Use of State Symbols of Kosova" {
    source "https://www.ecoi.net/en/file/local/1110062/1504_1220512574_law-on-use-of-state-symbols-of-kosova.pdf"
  }
  law "Law No. 03/L-132 on the State Protocol of the Republic of Kosovo" {
    source "https://web.archive.org/web/20170816235239id_/http://www.gazetazyrtare.com/e-gov/tr/index.php?option=com_content&task=view&id=351&Itemid=28"
  }
}
palette {
  blue "#244aa5" {
    cmyk 78 55 0 35
    reference "KosovaThanksYou, as reported by FOTW" "#183884"
  }
  gold "#d0a650" {
    cmyk 0 20 62 18
    reference "KosovaThanksYou, as reported by FOTW" "#dbbb5b"
  }
  white "#ffffff"
}
proportion hoist=5 fly=7

field blue
