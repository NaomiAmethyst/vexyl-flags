// From the law (Article 2, read in Armenian): red, blue and orange equal horizontal
// stripes from the top, width to length 1:2. The law gives no shade; its color drawing
// is in an annex that wasn't seen.
// From elsewhere: Pantone, CMYK, RGB and hex are Table 1 of the national standard
// HST 50-2012, read directly. That's a standard, not the law.
vexyl 1
meta {
  name "Armenia"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://web.archive.org/web/20230503144708/http://www.parliament.am/legislation.php?sel=show&ID=2711&lang=arm"
  source "https://web.archive.org/web/20171014133731/http://yeraguyn.com/wp-content/uploads/2010/04/HST-50-2012.pdf"
  source "https://www.crwflags.com/fotw/flags/am.html"
  note "The law names the colors without a shade. These values are from the national standard HST 50-2012, not the law."
  note "This reads the law as parliament published it. FOTW reports later amendments, up to July 2023, which weren't read."
  law "Law of the Republic of Armenia on the Flag of the Republic of Armenia, HO-149, 2006" {
    source "https://web.archive.org/web/20230503144708/http://www.parliament.am/legislation.php?sel=show&ID=2711&lang=arm"
  }
}
palette {
  red "#d90012" {
    pantone "485"
    cmyk 0 100 100 0
  }
  blue "#0033a0" {
    pantone "286"
    cmyk 100 80 0 0
  }
  orange "#f2a800" {
    pantone "1235"
    cmyk 0 35 100 0
  }
}
proportion hoist=1 fly=2

bars red blue orange
