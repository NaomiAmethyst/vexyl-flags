// Three vertical stripes of equal size, red at the hoist, on a 2:3 grid.
vexyl 1
meta {
  name "Guinea"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://web.archive.org/web/20261003001210id_/https://mjp.univ-perp.fr/constit/gn2025.htm"
  source "https://dgd.gov.gn/wp-content/uploads/2023/10/CHARTE-GRAPHIQUE-RG.pdf"
  source "https://www.crwflags.com/fotw/flags/gn.html"
  note "Article 4 of the 2025 constitution gives red, yellow and green in equal vertical stripes, from left to right."
  note "The 2:3 proportion isn't legal. FOTW lists it as approximate, and the government's graphic charter leaves it open."
  note "The hex and CMYK values are the Guinean government's graphic charter of 2021, p. 7, which isn't a law. FOTW reports Pantones 186 C, 116 C and 347 C from the Album des Pavillons 2023, with slightly different values, and says it found no official Pantone."
  law "Constitution of the Republic of Guinea, 26 September 2025, Article 4" {
    source "https://web.archive.org/web/20261003001210id_/https://mjp.univ-perp.fr/constit/gn2025.htm"
  }
}
palette {
  red "#ce1126" {
    cmyk 5 100 100 1
  }
  yellow "#fcd116" {
    cmyk 0 17 100 0
  }
  green "#009460" {
    cmyk 97 12 87 2
  }
}
proportion hoist=2 fly=3

bars red yellow green {
  along hoist
}
