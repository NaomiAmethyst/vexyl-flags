// Imported mechanically by tools/svg2vexyl.py. This describes a drawing, not the
// flag's official construction, and it hasn't been checked against one.
vexyl 1
meta {
  name "Flag of Libya"
  encoder "Various The SVG code is valid. This vector image was created with a text editor."
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Libya.svg"
}
palette {
  red "#e70013"
  black "#000000"
  green "#239e46"
  white "#ffffff"
}
proportion hoist=480 fly=960

bars red black green {
  ratio 1 2 1
}

charge disc white {
  radius 60
  at fly=480 hoist=240
  anchor center
}

charge disc black {
  radius 52.132
  at fly=492.132 hoist=240
  anchor center
}

charge star white {
  radius 44.6098
  rotate -18
  at fly=553.7852 hoist=240
}
