// Drawn from its source by tools/svg2vexyl.py, and not checked against an official construction.
vexyl 1
meta {
  name "Flag of Libya"
  encoder "Various The SVG code is valid. This vector image was created with a text editor."
  license "LicenseRef-Public-Domain"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Libya.svg"
}
palette {
  red "#e70013"
  black "#000000"
  green "#239e46"
  white "#ffffff"
}
proportion hoist=1 fly=2

bars red black green {
  ratio 1 2 1
}

charge disc white {
  radius 0.125
  at center
}

charge disc black {
  radius 0.1086
  at fly=1.0253 hoist=0.5
  anchor center
}

charge star white {
  radius 0.0929
  rotate -18
  at fly=1.1537 hoist=0.5
}
