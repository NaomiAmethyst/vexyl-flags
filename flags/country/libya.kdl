// From the Constitutional Declaration: length twice the width, stripes red, black and
// green, the black equal to the other two together. On a hoist of 24, 6, 12 and 6.
// From the Kingdom's booklet, with H the hoist of 24:
//   crescent's outer circle centered on the flag, diameter H/4, so R = 3
//   crescent's greatest width 1/6 of that diameter, so 1
//   a "270 crescent", read here as tips bounding 270 degrees of the outer circle, so
//     the tips are R sqrt(2) apart, 4.24264
//   star's uppermost and lowermost points the same distance apart, on a vertical line
//     tangent to the outer circle on the fly side, with one point aimed at the center
// Derived here from those:
//   the width gives inner = offset + 2, and the tips give offset = 5/(4/3 + sqrt(2)) * 1/3
//     so offset 0.60660 and inner 2.60660
//   star radius = 2.12132 / sin 72 = 2.23049
//   star center = 24 + 3 + 2.23049 cos 72 = 27.68926
vexyl 1
meta {
  name "Libya"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.constituteproject.org/constitution/Libya_2011"
  source "https://upload.wikimedia.org/wikipedia/commons/a/ae/Libyan_Flag_Construction_Ministry_of_Information_and_Guidance_1951.jpg"
  source "https://www.crwflags.com/fotw/flags/ly.html"
  note "The stripes and the proportion are Article 3 of the Constitutional Declaration of 2011, read in an English translation, and it doesn't size or place the crescent and star beyond naming them."
  note "The crescent and star are from the booklet The Libyan Flag and the National Anthem, from the Kingdom of Libya's Ministry of Information and Guidance. It describes the 1951 constitution's flag, and it isn't current law. Its \"width of the flag\" is taken as the hoist, and its \"270 crescent\" as 270 degrees of arc."
  note "The booklet names the shades only as sign red and permanent green. The hex, Pantone and CMYK are the Album des Pavillons 2023, as reported by FOTW, which doesn't say that it means these for Libya's flag specifically. The Album itself wasn't read. Black and white are plain."
  law "Constitutional Declaration of the National Transitional Council, 3 August 2011, Article 3" {
    source "https://www.constituteproject.org/constitution/Libya_2011"
  }
}
palette {
  red "#d21034" {
    pantone "186 C"
    cmyk 10 100 74 2
    reference "Booklet of the Kingdom of Libya" "sign red"
  }
  black "#000000"
  green "#007229" {
    pantone "356 C"
    cmyk 89 29 100 18
    reference "Booklet of the Kingdom of Libya" "permanent green"
  }
  white "#ffffff"
}
proportion hoist=24 fly=48

bars red black green {
  ratio 1 2 1
}
charge crescent white {
  radius 3
  inner 2.60660
  offset 0.60660
  at center
}
charge star white {
  radius 2.23049
  rotate -90
  at fly=27.68926 hoist=12
}
