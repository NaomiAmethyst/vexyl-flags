// From Article 112, on a hoist of 20:
//   hoist 2/3 of the fly, so a fly of 30
//   each red edge half the height of the blue, so 5, 10 and 5
//   moon diameter 4/5 of the blue's height, so a radius of 4
vexyl 1
meta {
  name "Laos"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.constituteproject.org/constitution/Laos_2015"
  source "https://en.wikipedia.org/wiki/Flag_of_Laos"
  source "https://www.crwflags.com/fotw/flags/la.html"
  note "The geometry is from an English translation of the Constitution as revised in 2015. The Lao text wasn't read. The words in brackets about the moon's diameter and the blue's height are the translator's."
  note "The Constitution gives no shade. The hex and CMYK values are Wikipedia's, in a section that cites no source. FOTW reports the London 2012 Olympic manual as giving Pantone 032 and 293, which aren't legal values either."
  law "Constitution of the Lao People's Democratic Republic, as revised in 2015, Article 112" {
    source "https://www.constituteproject.org/constitution/Laos_2015"
  }
}
palette {
  red "#ce1126" {
    cmyk 0 92 82 19
  }
  blue "#002868" {
    cmyk 100 62 0 59
  }
  white "#ffffff"
}
proportion hoist=20 fly=30

bars red blue red {
  ratio 1 2 1
}
charge disc white {
  radius 4
  at center
}
