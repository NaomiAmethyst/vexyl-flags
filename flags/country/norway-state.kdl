vexyl 1
meta {
  name "Norway (state and war flag)"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Norway,_state.svg"
  note "Sizes follow the drawing on Commons, not a checked construction sheet."
  note "Colors match norway.kdl, which says where they come from."
}
