  red "#e62d23"
  white "#ffffff"
  blue "#002569"
}
proportion hoist=16 fly=27
outline tongued {
  depth 11
  tongue 4
}
field red
cross blue {
  fly 7 2 18
  hoist 7 2 7
  fimbriate white 1
}
