// Widths are 13/48 of the hoist for the black band and 3/48 for each gold edge, per
// FOTW citing Album des Pavillons rather than a government document. It doesn't say
// which way they're measured, so they're taken across the band, as Commons draws it.
// Colors follow Commons.
vexyl 1
meta {
  name "Tanzania"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.fotw.info/flags/tz.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Tanzania.svg"
  note "Band widths follow FOTW citing Album des Pavillons rather than a government document. It doesn't say which way they're measured, so they're taken across the band, as the Commons drawing does."
}
palette {
  green "#1eb53a"
  blue "#00a3dd"
  gold "#fcd116"
  black "#000000"
}
proportion hoist=48 fly=72

bars green blue {
  along bend-sinister
}
band black {
  along bend-sinister
  width 13
  fimbriate gold 3
}
