// From the Constitution: four horizontal bands of equal width, blue, white, green, yellow,
// crossed in their middle by a red band of equal width, with a yellow five-pointed star in
// the upper left corner.
// From elsewhere: 2:3, so 8 x 12 with a red band of 2, is the Album. The star's center at
// 0.14 of the length is the Album of 1995, so 1.68. Its size and height are from Commons.
vexyl 1
meta {
  name "Central African Republic"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://faolex.fao.org/docs/pdf/caf233696.pdf"
  source "https://www.crwflags.com/fotw/flags/cf.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_the_Central_African_Republic.svg"
  note "The Constitution gives no proportion. The 2:3 is the Album des Pavillons 2000, as reported by FOTW, which also notes a 3:5 variant and says there's no official document on proportion."
  note "The star's distance from the hoist is the Album des Pavillons 1995, as reported by FOTW. The Album itself wasn't read. The radius of 0.9 and the height, with its bounding box centered in the blue band, are read from the Commons file's path. None of these is legal. Commons and FOTW's own image draw it at about 0.167, and no later Album edition is reported to place it."
  note "The hex, Pantone and CMYK values are the Album des Pavillons 2023, as reported by FOTW. The Album itself wasn't read."
  law "Constitution of 30 August 2023, Article 1" {
    source "https://faolex.fao.org/docs/pdf/caf233696.pdf"
  }
}
palette {
  blue "#002d72" {
    pantone "288 C"
    cmyk 100 87 32 13
  }
  white "#ffffff"
  green "#509e2f" {
    pantone "362 C"
    cmyk 72 12 100 1
  }
  yellow "#ffcc00" {
    pantone "116 C"
    cmyk 0 21 93 0
  }
  red "#c8102e" {
    pantone "186 C"
    cmyk 14 100 79 4
  }
}
proportion hoist=8 fly=12

bars blue white green yellow
band red {
  along hoist
  width 2
}
charge star yellow {
  radius 0.9
  at fly=1.68 hoist=1.0859
}
