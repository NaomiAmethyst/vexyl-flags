// From the law, the Schedule to the National Flag Act 2006:
//   width to length 2:3, stripes of blue, white and green at 3:4:3
//   a black Basotho hat centered in the white, 92% of its width (0.8 x 0.92 = 0.736 of
//   this grid's 2, so about 0.368 of the hoist)
//   Pantone Reflex Blue C, white, black, Pantone Green 347C
// From elsewhere: the hat's drawing is the Commons file, and it already measures 0.368 of
// the hoist, on center. The law gives Pantone only, so the hex values are from FOTW's page.
vexyl 1
meta {
  name "Lesotho"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Lesotho.svg" {
    author "Wikimedia Commons contributors, listed in the file's history"
    license "LicenseRef-Public-Domain"
    part "the hat"
  }
  source "https://archive.gazettes.africa/archive/ls/2006/ls-government-gazette-dated-2006-10-04-no-50.pdf"
  source "https://www.crwflags.com/fotw/flags/ls.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Lesotho.svg"
  note "The hat's outline comes from the Commons file Flag_of_Lesotho.svg, not the law. The law gives only its color, height and position."
  note "The law gives Pantone only. The green hex and CMYK are the Album des Pavillons 2023, as reported by FOTW. The blue hex is Flag Color Codes', as FOTW's page reports it for Reflex Blue: the Album's blue, RGB 0-20-67, is labeled Pantone Blue C rather than the law's Reflex Blue C, and is far darker, so it's kept only as a reference."
  law "National Flag Act 2006, Act No. 7 of 2006" {
    source "https://archive.gazettes.africa/archive/ls/2006/ls-government-gazette-dated-2006-10-04-no-50.pdf"
  }
  restriction "Section 5: any act showing disrespect, contempt or irreverence towards the flag is an offence, as is publicly displaying the flag of the repealed 1987 Act." {
    source "https://archive.gazettes.africa/archive/ls/2006/ls-government-gazette-dated-2006-10-04-no-50.pdf"
  }
}
palette {
  blue "#001489" {
    pantone "Reflex Blue C"
    reference "Album des Pavillons 2023, as reported by FOTW" "Pantone Blue C, CMYK 100-91-24-7, RGB 0-20-67"
  }
  white "#ffffff"
  green "#009543" {
    pantone "347 C"
    cmyk 84 12 94 1
  }
  black "#000000"
}
proportion hoist=2 fly=3

bars blue white green {
  ratio 3 4 3
}
