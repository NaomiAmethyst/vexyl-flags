palette {
  blue "#0000ff"
  black "#000000"
  white "#ffffff"
  red "#ff0000"
}
proportion hoist=5 fly=5

canton {
  fly 5
  hoist 5
  field blue
  charge polygon black {
    point fly=0 hoist=0
    point fly=5 hoist=0
    point fly=5 hoist=5
    point fly=0 hoist=5
    hollow 0.0208
  }
  charge rect white {
    fly 3
    hoist 3
    at center
  }
  charge rect red {
    fly 1
    hoist 1
    at center
  }
}
