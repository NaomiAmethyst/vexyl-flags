vexyl 1
meta {
  name "ICS Whiskey"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:ICS_Whiskey.svg" {
