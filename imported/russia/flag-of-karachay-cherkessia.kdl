  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Karachay-Cherkessia.svg" {
    license "LicenseRef-Public-Domain"
  }
}
palette {
  blue "#0090d0"
  green "#007030"
  red "#e02010"
  orange "#ffb000"
}
proportion hoist=1 fly=2

bars blue green red

charge disc orange {
  radius 0.0667
  at center
}

charge svg {
  at center
  fly 2
  hoist 1
  markup #"""
