// Drawn from its source by tools/svg2vexyl.py, and not checked against an official construction.
vexyl 1
meta {
  name "Flag of Zapopan"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Zapopan.svg" {
    author "Zapopan"
    license "LicenseRef-Public-Domain"
  }
}
palette {
  green "#008000"
  yellow "#ffd700"
}
proportion hoist=4 fly=7

bars green yellow {
  along hoist
}

charge svg {
  at center
  fly 7
  hoist 4
