// Drawn from its source by tools/svg2vexyl.py, and not checked against an official construction.
vexyl 1
meta {
  name "Flag of Zanzibar"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Zanzibar.svg" {
    author "Mysid"
    license "LicenseRef-Public-Domain"
  }
}
palette {
  green "#1eb53a"
  blue "#00a3dd"
  yellow "#fcd116"
  black "#000000"
  dark-blue "#0093cd"
}
proportion hoist=6 fly=9

field green

charge polygon blue {
  point fly=0 hoist=2
  point fly=3 hoist=2
  point fly=3 hoist=0
}

charge polygon yellow {
  point fly=0.2196 hoist=2.3294
  point fly=3.2196 hoist=0.3294
  point fly=2.7804 hoist=-0.3294
  point fly=-0.2196 hoist=1.6706
}

charge polygon black {
  point fly=0.15 hoist=2.2253
  point fly=3.15 hoist=0.2253
  point fly=2.85 hoist=-0.2253
  point fly=-0.15 hoist=1.7747
}

panel {
  corner upper-fly
  fly 6
  hoist 2
  field dark-blue
}

charge rect black {
  fly 9
  hoist 2
  at center
}
