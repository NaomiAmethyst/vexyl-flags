vexyl 1
meta {
  name "Flag of Kagawa Prefecture"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-3.0"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Kagawa_Prefecture.svg" {
