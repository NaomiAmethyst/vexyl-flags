// From the law, the Second Schedule of Act No. 5 of 2022: 4 horizontal stripes of equal
// width, red, blue, yellow and green from the top, 3 horizontally to 2 vertically.
// The Pantone cotton codes are the law's too.
// From elsewhere: the hex values are FOTW's approximations of those codes.
vexyl 1
meta {
  name "Mauritius"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://mauritiusassembly.govmu.org/mauritiusassembly/wp-content/uploads/2023/03/act0522.pdf"
  source "https://www.crwflags.com/fotw/flags/mu.html"
  note "The Act gives Pantone cotton codes only. The hex values are the approximations FOTW reports for those codes, based on icolorpalette.com, and aren't legal values."
  law "The National Flag, Arms of Mauritius, National Anthem and Other National Symbols of Mauritius Act 2022, Act No. 5 of 2022, section 5 and Second Schedule" {
    source "https://mauritiusassembly.govmu.org/mauritiusassembly/wp-content/uploads/2023/03/act0522.pdf"
  }
}
palette {
  red "#d01c1f" {
    pantone "18-1664 TCX"
  }
  blue "#2d3359" {
    pantone "19-3939 TCX"
  }
  yellow "#f7b718" {
    pantone "14-0957 TCX"
  }
  green "#008658" {
    pantone "17-6030 TCX"
  }
}
proportion hoist=2 fly=3

bars red blue yellow green
