// From the law: twice as long as wide, with five equal stripes, so 3 each on a hoist of 15.
// The red triangle is equilateral on the whole hoist, so its depth is 15 x sqrt(3) / 2.
// The star's circle has a diameter of 1/3 of the hoist, so radius 2.5. It's at the
// triangle's center, one third of the depth from the hoist (derived), with a point up.
vexyl 1
meta {
  name "Cuba"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://instituciones.sld.cu/facultadfinlayalbarran/files/2020/01/ley-128-sobre-los-simbolos.pdf"
  source "https://www.crwflags.com/fotw/flags/cu.html"
  note "The law fixes all of the geometry. It names the colors azul turqui, white and red with no shade, so the hex, Pantone and CMYK values are the Album des Pavillons 2023's, as reported by FOTW."
  note "Law 128 repeals Law 42 of 1983, which older sources cite."
  law "Law No. 128/2019 on the National Symbols of the Republic of Cuba, Article 7, Gaceta Oficial No. 71 of 19 September 2019 (GOC-2019-845-O71)" {
    source "https://instituciones.sld.cu/facultadfinlayalbarran/files/2020/01/ley-128-sobre-los-simbolos.pdf"
  }
}
palette {
  blue "#002a8f" {
    pantone "2146 C"
    cmyk 100 87 17 3
    reference "Law No. 128/2019" "azul turqui"
  }
  white "#ffffff"
  red "#c8102e" {
    pantone "186 C"
    cmyk 14 100 79 4
  }
}
proportion hoist=15 fly=30

bars blue white {
  count 5
}
chevrons red {
  depth 12.99038
}
charge star white {
  radius 2.5
  at fly=4.33013 hoist=7.5
}
