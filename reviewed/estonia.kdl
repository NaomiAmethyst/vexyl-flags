// Section 2: three horizontal stripes of equal width; width to length 7:11.
vexyl 1
meta {
  name "Estonia"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.wipo.int/wipolex/en/text/424353"
  source "https://www.crwflags.com/fotw/flags/ee.html"
  source "https://en.wikipedia.org/wiki/Flag_of_Estonia"
  note "The stripes and proportion are the law's section 2, read in the redaction in force from 1 July 2014 on WIPO Lex. Riigi Teataja couldn't be read, so later redactions weren't checked directly."
  note "Section 2 of that text names the colors only, and its annex image wasn't seen. Pantone 285 C is reported by FOTW from a 1992 law on the graphic specifications, and by Wikipedia from the Government Office. Neither of those was read."
  note "The hex and CMYK values are Wikipedia's. FOTW reports a different CMYK for the same blue, 91 43 0 0. Black and white are plain."
  law "Estonian Flag Act (Eesti lipu seadus), 2005, section 2" {
    source "https://www.wipo.int/wipolex/en/text/424353"
  }
}
palette {
  blue "#0072ce" {
    pantone "285 C"
    cmyk 100 45 0 19
  }
  black "#000000"
  white "#ffffff"
}
proportion hoist=7 fly=11

bars blue black white
