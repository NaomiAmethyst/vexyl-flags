// From Part II of the First Schedule of Cap. 300A: three equal vertical panels, a black
// broken trident in the center of the flag, in the proportion 3:2.
// The trident's size isn't in the Act, and comes from the Commons drawing.
vexyl 1
meta {
  name "Barbados"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Barbados.svg" {
    author "User:Denelson83"
    license "LicenseRef-Public-Domain"
    part "the broken trident"
  }
  source "https://www.wipo.int/wipolex/en/text/125063"
  source "https://www.barbadosparliament.com/main_page_content/show_content/14"
  source "https://www.crwflags.com/fotw/flags/bb.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Barbados.svg"
  note "The panels, trident's place, proportion and British standard color codes are Part II of the First Schedule of the Act, in WIPO's text as amended up to Act No. 1 of 1982."
  note "The hex, Pantone and CMYK are the Album des Pavillons 2023, as reported by FOTW, because the Act gives only its colour codes, recorded as references."
  note "The trident's drawing and size come from the Commons file and aren't from the law."
  note "Commons tags the drawing public domain, while this law vests copyright in the design in the Crown. The file's license follows Commons' tag and doesn't settle that."
  note "The text read predates the republic of November 2021, and whether later law changed it wasn't checked."
  design-rights "Section 3: copyright in the design of the National Emblems, which include the flag, is vested in the Crown in perpetuity."
  restriction "Section 4: importing, making or selling anything showing the National Emblems, or using them in connection with a business or body of persons, needs a licence from the Minister." {
    source "https://www.wipo.int/wipolex/en/text/125063"
  }
  law "National Emblems and National Anthem of Barbados (Regulation) Act, Cap. 300A" {
    source "https://www.wipo.int/wipolex/en/text/125063"
  }
}
palette {
  ultramarine "#012169" {
    pantone "280 C"
    cmyk 100 90 34 22
    reference "British Colour Council" "BCC 148"
  }
  gold "#ffc72c" {
    pantone "123 C"
    cmyk 0 24 86 0
    reference "British Standard" "BS 0/002"
  }
  black "#000000"
}
proportion hoist=2 fly=3

bars ultramarine gold ultramarine {
  along hoist
}
charge path black {
  d "M12000 4124C11740 4833 11475 5571 10908 6136C11084 6078 11392 6026 11590 6031L11590 9013L10748 9138C10718 9135 10708 9088 10708 9024C10627 8098 10408 7320 10156 6515C10138 6405 9819 5985 10065 6059C10095 6063 10424 6197 10372 6133C9924 5669 9269 5335 8633 5236C8577 5222 8544 5250 8594 5315C9438 6614 10144 8147 10138 9966C10466 9966 11261 9772 11590 9772L11590 11876L12005 11876L12100 6000Z"
  box "8544 4124 3556 7752"
  fly 0.4445
  hoist 0.969
  at fly=1.2902 hoist=1
}
charge path black {
  d "M12000 4124C12260 4833 12525 5571 13092 6136C12916 6078 12608 6026 12410 6031L12410 9013L13252 9138C13282 9135 13292 9088 13292 9024C13373 8098 13592 7320 13844 6515C13862 6405 14181 5985 13935 6059C13905 6063 13576 6197 13628 6133C14076 5669 14731 5335 15367 5236C15423 5222 15456 5250 15406 5315C14562 6614 13856 8147 13862 9966C13534 9966 12739 9772 12410 9772L12410 11876L11995 11876L11900 6000Z"
  box "11900 4124 3556 7752"
  fly 0.4445
  hoist 0.969
  at fly=1.7098 hoist=1
}
