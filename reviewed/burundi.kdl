// From Decree 1/31 of 1982, as FOTW reports it, in cm on 150 x 250: saltire arms 20, disc
// diameter 85, a circle of diameter 44 through the stars, each star in a circle of diameter
// 20, with a fimbriation 0.9 wide.
// Derived here: a 0.9 outline on a radius of 9.1 mitres out to 10 at each 60-degree point,
// which fits the outlined star inside the circle of 20, and leaves the green 0.9 wide.
vexyl 1
meta {
  name "Burundi"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.constituteproject.org/constitution/Burundi_2018"
  source "https://www.crwflags.com/fotw/flags/bi_const.html"
  source "https://www.crwflags.com/fotw/flags/bi.html"
  source "https://www.crwflags.com/fotw/images/b/bi'.gif"
  note "The Constitution gives the design and leaves dimensions to the law. Decree 1/31's dimensions are known only through FOTW, which reports them from its Article 1 and misdates the decree 1983 in one place. Its text wasn't read."
  note "The decree's text, as reported, doesn't say whether the fimbriation lies inside the circle of 20, or give its color. This file reads it as inside and green, as FOTW's construction sheet draws it."
  note "Which quarters are red and which green isn't in the text read. They follow FOTW's construction sheet."
  note "The hex, Pantone and CMYK values are the Album des Pavillons 2023, as reported by FOTW. The Album itself wasn't read."
  law "Constitution of 2018, on the national flag" {
    source "https://www.constituteproject.org/constitution/Burundi_2018"
  }
  law "Decree-Law No. 1/31 of 27 September 1982"
}
palette {
  red "#c8102e" {
    pantone "186 C"
    cmyk 14 100 79 4
  }
  green "#12ad2b" {
    pantone "2271 C"
    cmyk 78 0 100 0
    reference "Flags and Anthems Manual, London 2012, as reported by FOTW" "PMS 361"
  }
  white "#ffffff"
}
proportion hoist=150 fly=250

quarters red green red green {
  diagonal
}
saltire white {
  width 20
}
charge disc white {
  radius 42.5
  at center
}
charge star red {
  radius 9.1
  points 6
  at center
  repeat ring count=3 radius=22
}
charge star green {
  radius 9.1
  points 6
  hollow 0.9
  at center
  repeat ring count=3 radius=22
}
