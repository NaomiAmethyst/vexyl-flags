// Sizes follow the drawing on Commons, without the slight trim where it joins the red to
// the white.
vexyl 1
meta {
  name "Canada"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Canada_(Pantone).svg"
  note "Sizes follow the drawing on Commons, not a checked construction sheet."
}
