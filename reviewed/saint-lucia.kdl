// From the designer's description, on a 6 by 3 foot flag (72 by 36 inches):
//   common base of the triangles L/3 = 24; white 1.5 wide either side of the black;
//   4 between the black and white peaks
// Those fix the slope: 1.5 / 4 = 12 / side, so the white triangle's side is 32 and its height
// is sqrt(32^2 - 12^2) = 29.6648 (derived). The black runs parallel to it.
// Assumed: the device is centered on the hoist and the yellow's peak is the flag's center,
// from "the black ends as a three-pointed star in the centre".
vexyl 1
meta {
  name "Saint Lucia"
  designer "Dunstan St Omer"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.govt.lc/stluciaflag"
  source "https://www.crwflags.com/fotw/flags/lc.html"
  note "No law defining this flag was found. The sizes are the designer's description on the government's page and in a government notice quoted on FOTW. They don't say how large a flag the inches refer to: 6 by 3 feet is an assumption from FOTW's Zeljko Heimer, and it's the size that makes the 1.5 and the 4 agree."
  note "The notice names Cerulean Blue (Process Cyan 100%) and Light Chrome Yellow, with no screen values. The hex, Pantone and CMYK values are the Album des Pavillons 2023's, as FOTW reports them. Its Pantone 291 C is much lighter than process cyan."
  restriction "A government notice under the Customs (Control and Management) Act No. 23 of 1990 asks for the Office of the Prime Minister's permission before importing souvenirs bearing the flag." {
    source "https://www.crwflags.com/fotw/flags/lc.html"
  }
}
palette {
  blue "#a4ceec" {
    pantone "291 C"
    cmyk 40 8 2 0
    reference "Saint Lucia government notice" "Cerulean Blue, Process Cyan 100%"
  }
  white "#ffffff"
  black "#000000"
  yellow "#ffce00" {
    pantone "116 C"
    cmyk 0 19 93 0
    reference "Saint Lucia government notice" "Light Chrome Yellow"
  }
}
proportion hoist=36 fly=72

field blue
charge polygon white {
  point fly=36 hoist=3.1676
  point fly=48 hoist=32.8324
  point fly=24 hoist=32.8324
}
charge polygon black {
  point fly=36 hoist=7.1676
  point fly=46.382 hoist=32.8324
  point fly=25.618 hoist=32.8324
}
charge polygon yellow {
  point fly=36 hoist=18
  point fly=48 hoist=32.8324
  point fly=24 hoist=32.8324
}
