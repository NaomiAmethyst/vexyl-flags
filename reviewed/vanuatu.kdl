// From the law: the flag is the image in the Schedule to the Public Declaration of 19 March
// 1980, with no figures. Measured from that image, on 36 x 54 (the frame is 376 x 251 px):
//   length 1.498 x height; at the fly, stripes 14.9, 1.9, 2.1, 2.0, 15 of 36
//   black's outer edges run from the hoist corners to (27, 15) and (27, 21)
//   vertically, black 2.2 and yellow 2.3 along the arms
// Taken as 15:2:2:2:15, with arms as wide as the stripes, across their slope of 15/27, the
// rest is derived: vertical width 2 x sqrt(106)/9 = 2.288, so the yellow's edges meet the
// hoist at 2.288 and 4.576, and reach the stripes at (26.4816, 17) and (24.1632, 18).
vexyl 1
meta {
  name "Vanuatu"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  design-rights "The Government of Vanuatu claims absolute copyright in the National Symbols from 18 February 1980, by the Public Declaration of 19 March 1980."
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Vanuatu_(official).svg" {
    author "SiBr4"
    author "MapGrid"
    author "NorthTension"
    author "SpanishEmpireBall2009"
    author "IAmNotABananaaa"
    license "LicenseRef-Public-Domain"
    part "the boar's tusk and namele fronds"
  }
  source "https://web.archive.org/web/20241215140532/https://paclii.org/vu/legis/consol_sub/sfaabpd392/"
  source "https://web.archive.org/web/20250102034317/https://paclii.org/vu/legis/consol_sub/sfaabpd392.rtf"
  source "https://web.archive.org/web/20230825052004/http://www.paclii.org/vu/legis/consol_act/sfaaba265/"
  source "https://web.archive.org/web/20250102023208/https://paclii.org/vu/legis/num_act/sfaaba2013345.pdf"
  source "https://www.crwflags.com/fotw/flags/vu.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Vanuatu_(official).svg"
  note "The law's words don't describe the flag, so every size here is measured from the image in its Schedule or derived from those measurements, and none is stated in the law."
  note "FOTW reports 19:36 from a document of the premier's office, which wasn't read, and the Album des Pavillons 1990 gives 3:5. The Schedule's image is 2:3."
  note "The law gives no shades. The hex, Pantone and CMYK values are the Album des Pavillons 2023's, as reported by FOTW, and the Schedule's printed yellow is more orange. Black is plain black."
  note "The emblem's drawing comes from the Commons file and isn't from the law. Its yellow is set to this palette's. Commons calls the file public domain, while the Declaration claims copyright in the symbols."
  law "State Flag and Armorial Bearings Act, Chapter 107" {
    source "https://web.archive.org/web/20230825052004/http://www.paclii.org/vu/legis/consol_act/sfaaba265/"
    source "https://web.archive.org/web/20250102023208/https://paclii.org/vu/legis/num_act/sfaaba2013345.pdf"
  }
  law "State Flag and Armorial Bearings Public Declaration, 19 March 1980" {
    source "https://web.archive.org/web/20241215140532/https://paclii.org/vu/legis/consol_sub/sfaabpd392/"
    source "https://web.archive.org/web/20250102034317/https://paclii.org/vu/legis/consol_sub/sfaabpd392.rtf"
  }
  restriction "Chapter 107, section 2: without the Minister's written permit, no one may sell, make for sale or use in business a copy of the State Flag or anything closely resembling it." {
    source "https://web.archive.org/web/20230825052004/http://www.paclii.org/vu/legis/consol_act/sfaaba265/"
  }
}
