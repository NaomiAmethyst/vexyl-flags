// The Union Flag at 1:2, on the usual 30 by 60 construction: a white saltire 6 wide,
// a red one showing 2 wide on one side of each diagonal, then a red cross 6 wide with
// a white edge of 2. There's no statutory construction
// sheet that was found; this follows the common drawing on Commons, which it matches.
vexyl 1
meta {
  name "United Kingdom"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_the_United_Kingdom_(1-2).svg"
}
palette {
  blue "#012169"
  white "#ffffff"
  red "#c8102e"
}
proportion hoist=30 fly=60

field blue
saltire white {
  width 6
}

saltire red {
  width 2
  counterchange
}
cross red {
  fly 27 6 27
  hoist 12 6 12
  fimbriate white 2
}

// The diagonals follow the corners, and the cross stays centered at its own width.
adapt {
  wider center
  narrower center
}
