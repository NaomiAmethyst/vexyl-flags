// From the Schedule, on a flag of 144 by 288, with the first quarter 144 by 72.
// A star's stated size runs from one point to the next but one, so radius = size / (2 sin 72),
// its side points are size/2 from its center, and its bottom points are radius x cos 36 below.
// The positions and radii are derived from these. Each is below, with its size:
//   topmost, 16: top point 3 from the top, centered on the quarter, so 72, 3 + 8.4117
//   lowest, 20: bottom points 3 from the quarter's foot, so 72, 69 - 8.5065
//   staff, 16: top point 21 down, near point 42 from the staff, so 42 + 8, 21 + 8.4117
//   fly, 15: top point 18 down, near point 42 from the quarter's edge, so 144 - 42 - 7.5, 18 + 7.886
//   fifth, 10: bottom points 26 from the foot, near point 56 from the edge, so 144 - 56 - 5, 46 - 4.2533
vexyl 1
meta {
  name "Samoa"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://web.archive.org/web/20231124120226/https://www.mjca.gov.ws/achasoso/2021/05/Official-Flag-and-National-Anthem-of-Samoa-Act-1994.pdf"
  source "https://www.crwflags.com/fotw/flags/ws.html"
  note "All of the geometry is from the Act's Schedule, read in the official version as at 3 March 2021. The stars' centers and radii are worked out from its measurements."
  note "The Act names the colors with no shades. The hex, Pantone and CMYK values are the Album des Pavillons 2023's, as reported by FOTW. White is plain white."
  law "Official Flag and National Anthem of Samoa Act 1994, section 3 and Schedule" {
    source "https://web.archive.org/web/20231124120226/https://www.mjca.gov.ws/achasoso/2021/05/Official-Flag-and-National-Anthem-of-Samoa-Act-1994.pdf"
  }
}
palette {
  red "#d21034" {
    pantone "186 C"
    cmyk 10 100 74 2
  }
  blue "#003580" {
    pantone "294 C"
    cmyk 100 84 26 6
  }
  white "#ffffff"
}
proportion hoist=144 fly=288

field red
canton {
  fly 144
  hoist 72
  field blue
  charge star white {
    radius 8.4117
    at fly=72 hoist=11.4117
    at fly=50 hoist=29.4117
  }
  charge star white {
    radius 10.5146
    at fly=72 hoist=60.4935
  }
  charge star white {
    radius 7.886
    at fly=94.5 hoist=25.886
  }
  charge star white {
    radius 5.2573
    at fly=83 hoist=41.7467
  }
}
