// From the decree, Article 5: three horizontal stripes of equal size, as near as possible to
// 1:0.55 between the long side and the short, which is 20 by 11. Article 2: the arms in the
// center of the white stripe, a different one on each face.
vexyl 1
meta {
  name "Paraguay"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Paraguay.svg" {
    author "Wikimedia Commons contributors, listed in the file's history"
    license "LicenseRef-Public-Domain"
    part "the national coat of arms on the obverse"
  }
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Paraguay_(reverse).svg" {
    author "Wikimedia Commons contributors, listed in the file's history"
    license "LicenseRef-Public-Domain"
    part "the treasury seal on the reverse"
  }
  source "https://www.crwflags.com/fotw/flags/py_law.html"
  source "https://www.crwflags.com/fotw/flags/py.html"
  source "https://www.abc.com.py/edicion-impresa/suplementos/escolar/decreto-sobre-simbolos-nacionales-2-611141.html"
  source "https://www.lanacion.com.py/politica/2024/12/19/proyecto-de-ley-plantea-el-diseno-y-uso-de-simbolos-patrios-despues-de-182-anos/"
  note "The decree was read as Ivan Sache's English translation on FOTW, with Article 5 also read in Spanish in ABC Color. The official copy on the Presidency's site could not be retrieved, and its Appendix's drawings weren't seen."
  note "Both emblems' drawings come from the Commons files, not the decree, which gives no size for them on the flag. Their colors are the drawings' own and weren't checked against the Appendix's values."
  note "The decree asks only for 'primary colours' in red and blue, so the hex, Pantone and CMYK values are the Album des Pavillons 2023's, as FOTW reports them."
  note "A bill to regulate the symbols by law passed the Chamber of Deputies in December 2024 and was still being debated in July 2026. No sign was found that it has been enacted."
  law "Decree No. 11,400 of 15 July 2013 regulating the design and use of the flag of the Republic, the national arms and the national seal" {
    source "https://www.crwflags.com/fotw/flags/py_law.html"
    source "https://www.abc.com.py/edicion-impresa/suplementos/escolar/decreto-sobre-simbolos-nacionales-2-611141.html"
  }
  restriction "Article 10 of Decree 11,400: the patriotic colours and the flag can't be registered as intellectual property." {
    source "https://www.crwflags.com/fotw/flags/py_law.html"
  }
}
