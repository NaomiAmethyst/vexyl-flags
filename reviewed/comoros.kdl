// Measured from the Presidency's image, which is about 9:5, in units of a hoist of 144,
// and applied to the 3:5 reported elsewhere, on a grid of 144 by 240:
//   triangle depth 123.3
//   crescent radius 35.7, cut radius 36, offset 15.7, at (45.4, 72)
//   stars radius 6.5, centers 53.1 from the hoist, from 48.8 down in steps of 15.8
vexyl 1
meta {
  name "Comoros"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://cdn.accf-francophonie.org/2019/03/comores-consitution-2018.pdf"
  source "https://www.crwflags.com/fotw/flags/km.html"
  source "https://beit-salam.km/symboles-de-letat/"
  source "https://en.wikipedia.org/wiki/Flag_of_the_Comoros"
  note "Article 9 of the 2018 constitution gives four equal stripes in order, a green isosceles triangle on the hoist, a white crescent, and four white stars aligned from one end of the crescent to the other. It gives no sizes, proportion or shades."
  note "The 3:5 proportion isn't legal. It's what Wikipedia, the Commons drawing and FOTW's contributors give. FOTW also reports 2:3 from a flag chart, and the Presidency's page shows an image of about 9:5."
  note "The triangle and emblem sizes are measured from the Presidency's image, which is about 9:5 and states no figures, and applied to the 3:5 reported by FOTW and Wikipedia. The law gives none of them. FOTW's contributors judge the triangle to reach the flag's center."
  note "The law doesn't give the stars' orientation. Point up follows the Presidency's image and, per FOTW, the model supplied at adoption. FOTW also reports a flag with stars pointing to the fly."
  note "The hex, Pantone and CMYK values are the Album des Pavillons 2023's, as reported by FOTW, which says the government documents no shades. White is plain white."
  law "Constitution of the Union of the Comoros, 2018, Article 9" {
    source "https://cdn.accf-francophonie.org/2019/03/comores-consitution-2018.pdf"
  }
}
palette {
  yellow "#fdd100" {
    pantone "109 C"
    cmyk 1 17 93 0
  }
  white "#ffffff"
  red "#ef3340" {
    pantone "32 C"
    cmyk 0 89 68 0
  }
  blue "#0047b6" {
    pantone "293 C"
    cmyk 94 73 0 0
  }
  green "#009530" {
    pantone "355 C"
    cmyk 84 12 100 1
  }
}
proportion hoist=144 fly=240

bars yellow white red blue
pile green {
  depth 123.3
}
charge crescent white {
  radius 35.7
  inner 36
  offset 15.7
  at fly=45.4 hoist=72
}
charge star white {
  radius 6.5
  at fly=53.1 hoist=48.8
  repeat line count=4 hoist=15.8
}
