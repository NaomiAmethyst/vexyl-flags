// Per the Flag Rules 1972: 10:6, with a disc of radius 1/5 of the length, centered
// 9/20 along it. The rules specify Procion dyes, so these hex values are conversions
// through Pantone 342 C and 485 C, made by Wikipedia's editors.
vexyl 1
meta {
  name "Bangladesh"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://en.wikipedia.org/wiki/Flag_of_Bangladesh"
  note "The rules specify Procion dyes, so these hex values are conversions through Pantone, made by Wikipedia's editors."
  law "Flag Rules 1972"
}
palette {
  green "#006747" {
    dye "Procion Brilliant Green H-2RS, 50 parts per 1000"
    pantone "342 C"
  }
  red "#da291c" {
    dye "Procion Brilliant Orange H-2RS, 60 parts per 1000"
    pantone "485 C"
  }
}
proportion hoist=6 fly=10

field green
charge disc red {
  radius 2
  at fly=4.5 hoist=3
}
