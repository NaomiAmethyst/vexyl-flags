// The table attached to Executive Order 10834, as parts of the hoist, scaled by 13 so
// that each stripe, L = 1/13, is one grid unit:
//   A 1, B 1.9 = 24.7. C 7/13 = 7, D 0.76 = 9.88. K 0.0616, so the star's radius is
//   0.0308 * 13 = 0.4004.
//   E and F 0.054, G and H 0.063, are the table's rounded spacings. The grid spreads the
//   stars evenly instead, at C/10 = 0.0538 and D/12 = 0.0633, which is what they round.
vexyl 1
meta {
  name "United States"
  series "united-states"
  version "50-star"
  date "1960-07-04"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://web.archive.org/web/20231226213113/https://eca.state.gov/files/bureau/eca_design_guide.pdf"
  source "https://everyspec.com/FED_SPECS/F/download.php?spec=DDD-F-416F.049205.pdf"
  source "https://www.crwflags.com/fotw/flags/us.html"
  note "From the law: every proportion and the stars' positions, in the table and drawing attached to Executive Order 10834, and the red, white and blue in words, in 4 U.S.C. 1. The display rule is 4 U.S.C. 7(i). The order also authorizes other sizes for executive agencies, which aren't drawn here."
  note "From elsewhere: no law gives a shade. The hex, Pantone and CMYK values are the State Department ECA bureau's 2017 design guide, a government page and not law. Federal Specification DDD-F-416F names the colors as Old Glory Red and Blue from the Standard Color Reference of America, 10th edition, for procurement. FOTW reports the same RGB from the Album des Pavillons 2023, with different Pantones."
  note "Amendments: the National Archives' disposition table lists nothing that amends or revokes Executive Order 10834. 4 U.S.C. 1 and 2 stand as enacted in 1947. Section 7 was amended in 2007 and 2018, in its half-staff subsection only."
  law "Executive Order 10834" {
    source "https://www.govinfo.gov/content/pkg/FR-1959-08-25/pdf/FR-1959-08-25.pdf"
    source "https://www.archives.gov/federal-register/codification/executive-order/10834.html"
    source "https://www.archives.gov/federal-register/executive-orders/1959.html"
  }
  law "United States Flag Code, 4 U.S.C. 1, 2 and 7" {
    source "https://www.law.cornell.edu/uscode/text/4/1"
    source "https://www.law.cornell.edu/uscode/text/4/2"
    source "https://www.law.cornell.edu/uscode/text/4/7"
  }
}
palette {
  red "#b31942" {
    pantone "193 C"
    cmyk 0 100 66 13
    reference "Federal Specification DDD-F-416F" "Old Glory Red"
  }
  white "#ffffff" {
    cmyk 0 0 0 0
  }
  blue "#0a3161" {
    pantone "282 C"
    cmyk 100 68 0 54
    reference "Federal Specification DDD-F-416F" "Old Glory Blue"
  }
}
proportion hoist=13 fly=24.7

bars red white {
  count 13
}
canton {
  fly 9.88
  hoist 7
  field blue
  charge star white {
    radius 0.4004
    repeat grid rows=9 columns=11 stagger=#true
  }
}

// 4 U.S.C. section 7(i): against a wall, the union is uppermost and at the observer's
// left, horizontally or vertically. Stars stay upright, since they would otherwise
// point sideways.
variant vertical {
  from transpose
  upright
}

// Custom rather than the Flag Code: two folds lengthwise with the blue outside, then
// triangles from the striped end, with what's left at the hoist tucked in.
fold triangle {
  description "The customary triangular fold"
  source "https://www.va.gov/opa/publications/celebrate/flagfold.pdf"
  source "https://www.legion.org/advocacy/flag-advocacy/flag-folding-procedures"
  over along=fly at=6.5 move=bottom
  over along=fly at=3.25 move=bottom
  over through="24.7 0 21.45 3.25" move="24.7 3.25"
  over along=hoist at=21.45 move=fly
  over through="21.45 3.25 18.2 0" move="21.45 0"
  over along=hoist at=18.2 move=fly
  over through="18.2 0 14.95 3.25" move="18.2 3.25"
  over along=hoist at=14.95 move=fly
  over through="14.95 3.25 11.7 0" move="14.95 0"
  over along=hoist at=11.7 move=fly
  over through="11.7 0 8.45 3.25" move="11.7 3.25"
  over along=hoist at=8.45 move=fly
  over through="8.45 3.25 5.2 0" move="8.45 0"
  over along=hoist at=5.2 move=fly
  over through="5.2 0 1.95 3.25" move="5.2 3.25"
  tuck along=hoist at=1.95 move=hoist
}
