// Section 3: nine units across to six down, with three horizontal stripes.
vexyl 1
meta {
  name "Sierra Leone"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://web.archive.org/web/20240711024457/https://www.parliament.gov.sl/images/pdf/THE-CONSTITUTION-OF-SIERRA-LEONE-1991.pdf"
  source "https://www.crwflags.com/fotw/flags/sl.html"
  source "https://www.crwflags.com/fotw/flags/st.html"
  note "The stripes and proportion are from section 3, which gives no widths beyond three stripes and no shades. Equal widths are taken from its plain reading."
  note "The hex, Pantone and CMYK values are the Album des Pavillons 2023's, as reported by FOTW. For Pantone 300 C, FOTW's Sierra Leone page prints RGB 0-103-193 and its São Tomé page 0-103-198. This uses the latter, which its Saint Kitts page repeats."
  law "Constitution of Sierra Leone, 1991 (Act No. 6 of 1991), section 3" {
    source "https://web.archive.org/web/20240711024457/https://www.parliament.gov.sl/images/pdf/THE-CONSTITUTION-OF-SIERRA-LEONE-1991.pdf"
  }
}
palette {
  green "#12ad2b" {
    pantone "361 C"
    cmyk 78 0 100 0
  }
  white "#ffffff"
  blue "#0067c6" {
    pantone "300 C"
    cmyk 88 57 0 0
  }
}
proportion hoist=6 fly=9

bars green white blue
