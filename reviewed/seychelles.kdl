  blue "#002f6c"
  yellow "#fed141"
  red "#d22730"
  white "#ffffff"
  green "#007a33"
}
proportion hoist=3 fly=6

rays blue yellow red white green {
  from lower-hoist
  measure edge
  ratio 2 2 3 1 1
}
