vexyl 1
meta {
  name "Seychelles"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Seychelles.svg"
  note "Sizes follow the drawing on Commons, not a checked construction sheet."
}
