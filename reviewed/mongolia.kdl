// From the law, Article 11: red, blue, red, the middle a third of the flag; the golden
// Soyombo in the center of the red by the staff; width to length 1:2.
// From the standard MNS 6262:2011, not a law, in its picture's unit a = 1/60 of the hoist:
//   stripes 40 each; the Soyombo 22 wide and 45 tall, 6 below the top
// The discs are from the Commons file's construction, which agrees with the standard's
// picture where that gives a measure: moon 11 wide, disc of the two fish 10 across.
vexyl 1
meta {
  name "Mongolia"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Mongolia.svg" {
    author "Wikimedia Commons contributors, listed in the file's history"
    license "LicenseRef-Public-Domain"
    part "the Soyombo"
  }
  source "https://web.archive.org/web/20231207235300/https://legalinfo.mn/mn/detail?lawId=496"
  source "https://web.archive.org/web/20130314013607/http://www.president.mn/mongolian/node/1958"
  source "https://web.archive.org/web/2012/http://www.president.mn/eng/newsCenter/viewNews.php?newsId=573"
  source "https://web.archive.org/web/20130314013607im_/http://open-government.mn/newspic/fs6.jpg"
  source "https://web.archive.org/web/20130314013607im_/http://open-government.mn/newspic/fs1.jpg"
  source "https://web.archive.org/web/20130314013607im_/http://open-government.mn/newspic/fs2.jpg"
  source "https://web.archive.org/web/20130314013607im_/http://open-government.mn/newspic/fs3.jpg"
  source "https://www.crwflags.com/fotw/flags/mn.html"
  note "The Soyombo's outline comes from the Commons file. The standard defines it by construction drawings, which were read at low resolution; no difference of design shows."
  note "MNS 6262:2011 is a national standard, not a law. Its text prints the yellow's CMYK as C0 M15 Y0 K0, but its own swatch figure shows 0 15 100 0, as recorded here."
  note "The standard gives colors as CMYK only. The hex values are measured here from its color swatch images, as the median of each swatch in a JPEG, so they're approximate."
  note "The law also requires the model annexed to the Constitution, which wasn't read."
  law "Law of Mongolia on State Symbols, Article 11, read at a December 2023 snapshot" {
    source "https://web.archive.org/web/20231207235300/https://legalinfo.mn/mn/detail?lawId=496"
  }
}
palette {
  red "#c4272e" {
    cmyk 10 100 90 0
  }
  blue "#015198" {
    cmyk 100 60 0 0
  }
  gold "#f9cf00" {
    cmyk 0 15 100 0
  }
}
