// From the law, Article 1 of Law No. 22 of 2005 as replaced by Law No. 5 of 2006, read in
// Arabic: three equal horizontal parts, black, white and green from the top; width half the
// length; a red triangle at the mast, its base the flag's width and its height 1/3 of the
// length, so 2 on this grid.
// From elsewhere: the law gives no shades. Red and green are the Album des Pavillons
// 2023's, as FOTW reports it. Black and white are plain.
vexyl 1
meta {
  name "Palestine"
  series "palestine"
  version "2006"
  date "2006-02-17"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://web.archive.org/web/20260517111805id_/http://muqtafi.birzeit.edu/pg/getleg.asp?id=15212"
  source "https://web.archive.org/web/20261017121237id_/http://muqtafi.birzeit.edu/pg/getleg.asp?id=15137"
  source "https://www.crwflags.com/fotw/flags/ps.html"
  note "The 2005 text set the triangle's height at half its base. The 2006 law replaced that with 1/3 of the flag's length, and took effect when issued on 17 February 2006."
  note "The law refers to the colors and dimensions adopted by the Palestine Liberation Organization, but gives no shades. The red and green hex, Pantone and CMYK values are the Album des Pavillons 2023's, as reported by FOTW."
  law "Law No. 22 of 2005 on the Sanctity of the Palestinian Flag, Article 1" {
    source "https://web.archive.org/web/20261017121237id_/http://muqtafi.birzeit.edu/pg/getleg.asp?id=15137"
  }
  law "Law No. 5 of 2006 amending Law No. 22 of 2005" {
    source "https://web.archive.org/web/20260517111805id_/http://muqtafi.birzeit.edu/pg/getleg.asp?id=15212"
  }
}
palette {
  black "#000000"
  white "#ffffff"
  green "#289728" {
    pantone "362 C"
    cmyk 80 12 100 2
  }
  red "#d21034" {
    pantone "186 C"
    cmyk 10 100 74 2
  }
}
proportion hoist=3 fly=6

bars black white green
chevrons red {
  depth 2
}
