// From the law, Article 8: blue, gold and red in vertical bands of equal size, with the
// blue at the pole. From elsewhere: the law gives no proportion, and 2:3 is FOTW's.
vexyl 1
meta {
  name "Chad"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://extranet.who.int/cpcd/sites/default/files/public_file_repository/TCD_Chad_Constitution_2023.pdf"
  source "https://www.crwflags.com/fotw/flags/td.html"
  note "The constitution gives no proportion. The 2:3 is FOTW's and Wikipedia's, and FOTW's contributor notes the ratio is unspecified, so it isn't legal."
  note "The Constitutional Law of October 2025 revised this constitution, and its text wasn't read. Press accounts of it don't mention the flag."
  note "The constitution gives no shades. The hex and CMYK values are the Album des Pavillons 2023's, as reported by FOTW. FOTW's listing assigns Pantone 115 C to the red and 281 C to the yellow, which looks scrambled, so only the blue's Pantone is kept here."
  law "Constitution of the Republic of Chad, 29 December 2023, Article 8" {
    source "https://extranet.who.int/cpcd/sites/default/files/public_file_repository/TCD_Chad_Constitution_2023.pdf"
  }
}
palette {
  blue "#002569" {
    pantone "281 C"
    cmyk 100 89 34 21
  }
  yellow "#ffde00" {
    cmyk 2 9 91 0
  }
  red "#de2f2d" {
    cmyk 4 92 83 0
  }
}
proportion hoist=2 fly=3

bars blue yellow red {
  along hoist
}
