// From Article 3: cloth in the proportions of 5 to 3 or 2 to 1, with three equal bands
// of red, white and blue, set horizontally.
vexyl 1
meta {
  name "Luxembourg"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://data.legilux.public.lu/filestore/eli/etat/leg/memorial/1972/a51/fr/pdf/eli-etat-leg-memorial-1972-a51-fr-pdf.pdf"
  source "https://data.legilux.public.lu/filestore/eli/etat/leg/memorial/1993/a73/fr/pdf/eli-etat-leg-memorial-1993-a73-fr-pdf.pdf"
  source "https://www.crwflags.com/fotw/flags/lu.html"
  note "The law allows both proportions. This file's own is 5:3, and the variant is 2:1."
  note "Pantone 032 C and 299 C are the Grand-Ducal Regulation of 27 July 1993. The hex and CMYK values are the Album des Pavillons 2023, as reported by FOTW, except that FOTW's CMYK for this blue doesn't fit its RGB, so it's left out. The Album itself wasn't read."
  law "Law of 23 June 1972 on national emblems, as amended on 27 July 1993, Article 3" {
    source "https://data.legilux.public.lu/filestore/eli/etat/leg/memorial/1972/a51/fr/pdf/eli-etat-leg-memorial-1972-a51-fr-pdf.pdf"
    source "https://data.legilux.public.lu/filestore/eli/etat/leg/memorial/1993/a73/fr/pdf/eli-etat-leg-memorial-1993-a73-fr-pdf.pdf"
  }
  law "Grand-Ducal Regulation of 27 July 1993 on the colors of the national flag and the ensign" {
    source "https://data.legilux.public.lu/filestore/eli/etat/leg/memorial/1993/a73/fr/pdf/eli-etat-leg-memorial-1993-a73-fr-pdf.pdf"
  }
}
palette {
  red "#e62d23" {
    pantone "032 C"
    cmyk 0 92 89 0
  }
  white "#ffffff"
  blue "#00a0e2" {
    pantone "299 C"
  }
}
proportion hoist=3 fly=5

bars red white blue

variant long {
  proportion hoist=1 fly=2
  bars red white blue
}
