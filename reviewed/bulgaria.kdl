// From the law, Article 15 and Appendix 2, read in Bulgarian: white, green and red equal
// horizontal fields, 3:5; 2:3 at sea; white of at least 80% whiteness, green Pantone
// textile 17-5936 TC and red 18-1664 TC, or 347 U and 032 U when printed on paper.
// Hanging, the colors run left to right from the viewer, and may reach five widths.
// From elsewhere: the law gives no hex or CMYK. These are the Album des Pavillons 2023's
// values for those two textile Pantones, as FOTW reports it. White is plain white.
vexyl 1
meta {
  name "Bulgaria"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://web.archive.org/web/20241114145302/https://lex.bg/laws/ldoc/2134401024"
  source "https://www.crwflags.com/fotw/flags/bg.html"
  note "The law gives Pantone numbers and a whiteness, not screen colors. The hex and CMYK values are the Album des Pavillons 2023's, as reported by FOTW."
  law "Law on the State Seal and National Flag of the Republic of Bulgaria, Article 15 and Appendix 2" {
    source "https://web.archive.org/web/20241114145302/https://lex.bg/laws/ldoc/2134401024"
  }
}
palette {
  white "#ffffff" {
    reference "Whiteness" "at least 80%"
  }
  green "#009b75" {
    pantone "17-5936 TC"
    cmyk 81 12 65 1
    reference "Pantone, printed on paper" "347 U"
  }
  red "#d01c1f" {
    pantone "18-1664 TC"
    cmyk 11 98 93 2
    reference "Pantone, printed on paper" "032 U"
  }
}
proportion hoist=3 fly=5

bars white green red

adapt {
  range 1.5 1.6667
  narrower scale
}

// Appendix 2: the flag for sea and river navigation is 2:3.
variant maritime {
  ratio 1.5
}

// Article 15(2): vertical on a crossbar, white, green, red from the viewer's left.
variant hanging {
  from transpose
}
