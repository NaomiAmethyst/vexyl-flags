2 22 32" fill="#009440" transform="matrix(0.953717 0.300706 -0.300706 0.953717 2190.448095 1321.065476)"/><path d="m0 0a31.5 35 0 0 0 0-70 31.5 35 0 0 0 0 70m0-13a18.5 22 0 0 0 0-44 18.5 22 0 0 0 0 44" fill="#009440" fill-rule="evenodd" transform="matrix(0.936672 0.350207 -0.350207 0.936672 2274.47703 1349.998959)"/><path d="m0 0a31.5 35 0 0 0 0-70 31.5 35 0 0 0 0 70m0-13a18.5 22 0 0 0 0-44 18.5 22 0 0 0 0 44" fill="#009440" fill-rule="evenodd" transform="matrix(0.91706 0.398749 -0.398749 0.91706 2356.876545 1383.290524)"/><path d="M5-35H31.5V-25H5z" fill="#009440" transform="matrix(0.91706 0.398749 -0.398749 0.91706 2356.876545 1383.290524)"/><path d="m21.5-35h10v35h-10z" fill="#009440" transform="matrix(0.91706 0.398749 -0.398749 0.91706 2356.876545 1383.290524)"/><path d="m-31.5 0h13v-26h28a22 22 0 0 0 0-44h-40zm13-39h27a9 9 0 0 0 0-18h-27z" fill="#009440" fill-rule="evenodd" transform="matrix(0.894934 0.446198 -0.446198 0.894934 2437.420788 1420.848921)"/><path d="m28 0c0-10 0-32-15-32h-19c22 0 22 22 22 32" fill="#009440" transform="matrix(0.894934 0.446198 -0.446198 0.894934 2437.420788 1420.848921)"/><path d="m0 0h63v-13h-51v-18h40v-12h-40v-14h48v-13h-60z" transform="matrix(0.870356 0.492424 -0.492424 0.870356 2488.472789 1447.059864)" fill="#009440"/><path d="m-15.75-22c0 7 6.75 10.5 16.75 10.5s14.74-3.25 14.75-7.75c0-14.25-46.75-5.25-46.5-30.25 0.25-21.5 24.75-20.5 33.75-20.5s26 4 25.75 21.25h-15.25c0-7.5-7-10.25-15-10.25-7.75 0-13.25 1.25-13.25 8.5-0.25 11.75 46.25 4 46.25 28.75 0 18.25-18 21.75-31.5 21.75-11.5 0-31.55-4.5-31.5-22z" fill="#009440" transform="matrix(0.843391 0.5373 -0.5373 0.843391 2592.066085 1508.343021)"/><path d="m-15.75-22c0 7 6.75 10.5 16.75 10.5s14.74-3.25 14.75-7.75c0-14.25-46.75-5.25-46.5-30.25 0.25-21.5 24.75-20.5 33.75-20.5s26 4 25.75 21.25h-15.25c0-7.5-7-10.25-15-10.25-7.75 0-13.25 1.25-13.25 8.5-0.25 11.75 46.25 4 46.25 28.75 0 18.25-18 21.75-31.5 21.75-11.5 0-31.55-4.5-31.5-22z" fill="#009440" transform="matrix(0.814116 0.58070