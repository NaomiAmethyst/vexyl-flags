// From Law 5.700, Article 5, in modules: 14 x 20, lozenge corners 1.7 from the frame, so
// 16.6 x 10.6, disc radius 3.5. Star diameters: 0.30, 0.25, 0.20, 1/7 and 0.10, so the radii
// here are half of those. The band's arcs (radii 8 and 8.5, centered 2 left of where the
// disc's vertical diameter, extended, meets the frame's base) are in the artwork, whose numbers match those.
// From elsewhere: star coordinates are read from the Commons file. Colors are the Album.
vexyl 1
meta {
  name "Brazil"
  date "1992-05-12"
  designer "Raimundo Teixeira Mendes"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Brazil.svg" {
    author "Wikimedia Commons contributors, listed in the file's history"
    license "LicenseRef-Public-Domain"
    part "the band, the lettering and the star coordinates"
  }
  source "https://en.wikipedia.org/wiki/File:Flag_of_Brazil.svg"
  source "https://web.archive.org/web/2024/https://www.planalto.gov.br/ccivil_03/leis/l5700compilado.htm"
  source "https://web.archive.org/web/2024/https://www.planalto.gov.br/ccivil_03/leis/l8421.htm"
  source "https://web.archive.org/web/20241219230407/https://www.planalto.gov.br/ccivil_03/leis/1989_1994/anexo/ANL8421-92.pdf"
  source "https://www.crwflags.com/fotw/flags/br.html"
  note "The band and the lettering are drawn in the artwork, which comes from the Commons file named above and isn't from the law. Its lettering is in that file's green, #009440, not this palette's."
  note "The law places the stars and the letters by its Annex 2 drawing, with no coordinates. The star coordinates here are the Commons file's, checked by eye against the annex, not measured from it."
  note "The fourth-magnitude star follows the law's 1/7 module diameter. The law's own parenthesis rounds this to 0.14, and Commons draws 0.15."
  note "The law gives no shades. The hex, Pantone and CMYK values are the Album des Pavillons 2023, as reported by FOTW. The Album itself wasn't read. FOTW also reports Pantone 355, Yellow and 280 for the federal government's mark, which is said to use the flag's colors."
  law "Law No. 5.700 of 1 September 1971, Articles 3 and 5, as amended" {
    source "https://web.archive.org/web/2024/https://www.planalto.gov.br/ccivil_03/leis/l5700compilado.htm"
  }
  law "Law No. 8.421 of 11 May 1992, replacing Annexes 1 and 2" {
    source "https://web.archive.org/web/2024/https://www.planalto.gov.br/ccivil_03/leis/l8421.htm"
    source "https://web.archive.org/web/20241219230407/https://www.planalto.gov.br/ccivil_03/leis/1989_1994/anexo/ANL8421-92.pdf"
  }
}
palette {
  green "#009530" {
    pantone "355 C"
    cmyk 84 12 100 1
  }
  yellow "#f8c100" {
    pantone "7408 C"
    cmyk 3 25 95 0
  }
  blue "#003580" {
    pantone "287 C"
    cmyk 100 84 26 6
  }
  white "#ffffff"
}
proportion hoist=14 fly=20

field green
charge lozenge yellow {
  fly 16.6
  hoist 10.6
  at center
}
charge disc blue {
  radius 3.5
  at center
}
charge svg {
  at center
  fly 20
  hoist 14
  markup #"""
