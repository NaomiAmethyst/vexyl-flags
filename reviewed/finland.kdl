// Section 2: height 11, length 18; cross arm 3; fields 4 high, the hoist fields 5 long
// and the outer fields 10 long. So 5:3:10 by 4:3:4.
vexyl 1
meta {
  name "Finland"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://www.finlex.fi/fi/laki/ajantasa/1978/19780380"
  source "https://www.finlex.fi/fi/lainsaadanto/saadoskokoelma/1993/827"
  note "The cross and proportion are the 1978 act's. The CIE values and the NCS and PMS approximations are the 1993 decision's."
  note "The decision defines blue in CIE, with PMS and NCS only as approximations. The hex is derived here from its L*a*b* values with a D65 white, as section 3 specifies, and Wikipedia gives the same. Its Yxy values give #134483 instead, because its L*a*b* appears to be computed against illuminant C. The two are within its tolerance of 4 delta E. It isn't a legal value. Wikipedia's other value, #002f6c, is a conversion of the PMS approximation."
  note "White is plain white."
  law "Act on the Flag of Finland, 380/1978, section 2" {
    source "https://www.finlex.fi/fi/laki/ajantasa/1978/19780380"
  }
  law "Government Decision on the colors of the Finnish flag, 827/1993" {
    source "https://www.finlex.fi/fi/lainsaadanto/saadoskokoelma/1993/827"
  }
}
palette {
  white "#ffffff"
  blue "#18447e" {
    pantone "294 C"
    ncs "4060-R90B"
    reference "CIE 1931 Y x y" "5.86 0.1856 0.1696"
    reference "CIE 1976 L* a* b*" "29.06 7.24 -36.98"
  }
}
proportion hoist=11 fly=18

field white
cross blue {
  fly 5 3 10
  hoist 4 3 4
}
