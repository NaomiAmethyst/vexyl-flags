// No law gives any geometry. Album des Pavillons 2000, as FOTW reports it: 1:2 with the
// canton (3+3):(5+7), which is 12 by 20 on this 24 by 48 grid. The Album doesn't size the
// cross, and FOTW's contributor says it apparently matches the Flag Institute's: arms 2 wide
// and 6 across a canton 8 high, so here width 3 and radius 4.5.
vexyl 1
meta {
  name "Tonga"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://www.constituteproject.org/constitution/Tonga_2013"
  source "https://web.archive.org/web/20250502100810/https://ago.gov.to/cms/images/LEGISLATION/PRINCIPAL/1962/1962-0017/RoyalArmsandFlagAct_3.pdf"
  source "https://www.crwflags.com/fotw/flags/to.html"
  note "The Constitution says only that the flag shall never be altered, and the Act doesn't describe it. Tonga has no official construction sheet, so all the geometry here is secondary and not legal."
  note "The proportion and canton are the Album des Pavillons 2000's, as reported by FOTW. The Flag Institute's specification, also reported by FOTW, makes the canton 3/8 of the length rather than 5/12."
  note "The hex, Pantone and CMYK values are the Album des Pavillons 2023's, as reported by FOTW. The London 2012 manual gives Pantone 032 instead."
  law "Constitution of Tonga, clause 47" {
    source "https://www.constituteproject.org/constitution/Tonga_2013"
  }
  law "Tonga Royal Arms and Flag Act, Cap. 1.05" {
    source "https://web.archive.org/web/20250502100810/https://ago.gov.to/cms/images/LEGISLATION/PRINCIPAL/1962/1962-0017/RoyalArmsandFlagAct_3.pdf"
  }
  restriction "Sections 2 and 3: the flag may not be used in connection with a business, calling or profession so as to suggest authority to use it, without Cabinet's authority, and such authority doesn't allow business use or use on a patented article." {
    source "https://web.archive.org/web/20250502100810/https://ago.gov.to/cms/images/LEGISLATION/PRINCIPAL/1962/1962-0017/RoyalArmsandFlagAct_3.pdf"
  }
}
palette {
  red "#d21034" {
    pantone "186 C"
    cmyk 10 100 74 2
  }
  white "#ffffff"
}
proportion hoist=24 fly=48

field red
canton {
  fly 20
  hoist 12
  field white
  charge plus red {
    radius 4.5
    width 3
    at center
  }
}
