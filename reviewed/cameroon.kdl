// From the law: three equal vertical stripes of green, red and yellow, with one gold star
// in the center of the red. Decree 76-424, as FOTW reports it, adds 2:3.
// From elsewhere: no law sizes the star. Its radius is measured from the Commons drawing,
// 0.797 on this 6 by 9 grid.
vexyl 1
meta {
  name "Cameroon"
  encoder "Naomi Persephone Amethyst"
  license "Apache-2.0"
  source "https://www.constituteproject.org/constitution/Cameroon_2008"
  source "https://www.crwflags.com/fotw/flags/cm.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Cameroon.svg"
  note "The 2:3 is Decree 76-424 of 16 September 1976, whose text wasn't read. FOTW's contributor reports it from Gervais Mbarga's book on the flag."
  note "No law sizes the star, and FOTW reports flags with stars of many sizes. This radius is measured from the drawing on Commons and isn't legal."
  note "The constitution says green, red, yellow and gold, with no shades. The hex, Pantone and CMYK values are the Album des Pavillons 2023's, as reported by FOTW."
  law "Constitution of the Republic of Cameroon, Law No. 96-06 of 18 January 1996, as amended 2008, Article 1" {
    source "https://www.constituteproject.org/constitution/Cameroon_2008"
  }
  law "Decree No. 76-424 of 16 September 1976"
}
palette {
  green "#007856" {
    pantone "341 C"
    cmyk 87 28 74 14
  }
  red "#c8102e" {
    pantone "186 C"
    cmyk 14 100 79 4
  }
  yellow "#ffcc00" {
    pantone "116 C"
    cmyk 0 21 93 0
  }
}
proportion hoist=6 fly=9

bars green red yellow {
  along hoist
}
charge star yellow {
  radius 0.797
  at center
}
