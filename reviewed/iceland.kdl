// From Article 1, on the law's own 18:25:
//   white cross arms 2/9 of the flag's breadth, so 4 of 18
//   red cross arms 1/9, so 2 of 18, leaving 1 of white on each side
//   hoist fields square, so 7 by 7, and the fly fields as broad but twice as long, 14
//   so the fly reads 7 1 2 1 14 and the hoist 7 1 2 1 7
vexyl 1
meta {
  name "Iceland"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://web.archive.org/web/20261009181914id_/https://www.althingi.is/lagasafn/pdf/158a/1944034.pdf"
  source "https://www.stjornartidindi.is/Advert.aspx?RecordID=2eb0fa5c-7754-4816-ad41-2fe15fdb8e7b"
  source "https://www.government.is/topics/governance-and-national-symbols/icelandic-national-flag/"
  note "Geometry is from Article 1 of the Flag Act, in the law collection edition of 1 October 2026."
  note "Every color value is from Announcement 32/2016, which replaced Announcement 6/1991. SCOTDIC is its basis, and it gives the others for print and screens."
  law "Act No. 34/1944 on the National Flag of Icelanders and the State Coat of Arms" {
    source "https://web.archive.org/web/20261009181914id_/https://www.althingi.is/lagasafn/pdf/158a/1944034.pdf"
  }
  law "Announcement No. 32/2016 on the colors of the Icelandic flag" {
    source "https://www.stjornartidindi.is/Advert.aspx?RecordID=2eb0fa5c-7754-4816-ad41-2fe15fdb8e7b"
  }
}
palette {
  blue "#02529c" {
    pantone "287"
    cmyk 100 75 2 18
    reference "SCOTDIC" "693009"
    reference "Avery" "520"
  }
  white "#ffffff" {
    cmyk 0 0 0 0
    reference "SCOTDIC" "95"
    reference "Avery" "501"
  }
  red "#dc1e35" {
    pantone "199"
    cmyk 0 100 72 0
    reference "SCOTDIC" "ICELAND FLAG RED"
    reference "Avery" "503"
  }
}
proportion hoist=18 fly=25

field blue
cross red {
  fly 8 2 15
  hoist 8 2 8
  fimbriate white 1
}
