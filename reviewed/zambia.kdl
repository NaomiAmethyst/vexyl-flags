// From the law, the construction drawing in Part I of the Schedule: 21 x 14 (the text says
// 3:2), with 13 1/2 of green and then three stripes of 2 1/2 each, 9 high.
//   the eagle is 2 5/8 high, on the center line of the stripes: 13.5 + 7.5/2 = 17.25
//   it's centered in the 5 above them, at 2.5: the gaps measure about equal in the drawing
// The eagle's frame is a little larger than 2 5/8, to hold the outline's stroke.
vexyl 1
meta {
  name "Zambia"
  designer "Gabriel Ellison"
  encoder "Naomi Persephone Amethyst"
  license "LicenseRef-Public-Domain"
  adapted-from "https://commons.wikimedia.org/wiki/File:Flag_of_Zambia.svg" {
    author "Wikimedia Commons contributors, listed in the file's history"
    license "LicenseRef-Public-Domain"
    part "the eagle"
  }
  source "https://web.archive.org/web/20251206125932/https://zambialii.org/akn/zm/act/1965/23/eng@1996-12-31"
  source "https://web.archive.org/web/20251231163152im_/https://media.zambialii.org/media/legislation/19688/images/6b7bf02ccfd67a7d/National_Flag_1.JPG"
  source "https://web.archive.org/web/20260217021745/https://www.policyvault.africa/wp-content/uploads/policy/ZMB752.pdf"
  source "https://web.archive.org/web/20260317032742/https://www.mcti.gov.zm/wp-content/uploads/2023/09/Press-release-National-flag.pdf"
  source "https://www.crwflags.com/fotw/flags/zm.html"
  source "https://commons.wikimedia.org/wiki/File:Flag_of_Zambia.svg"
  note "The law gives colors only as British Colour Council shades, recorded here. The hex, Pantone and CMYK values are the Album des Pavillons 2023's, as reported by FOTW. Black is plain black."
  note "The eagle's drawing comes from the Commons file and isn't from the law. It's a different eagle from the Schedule's: scaled to the law's height of 2 5/8, it's about 5.4 wide, and the Schedule's measures about 6.8. Its orange is set to this palette's."
  note "FOTW reports that the green and the eagle were changed in 1996, but neither FOTW nor this file's author found legislation for it, and the Ministry's 2023 release repeats the 1965 shades."
  law "National Flag and Armorial Ensigns Act, Chapter 6 of the Laws of Zambia (No. 23 of 1965, as amended by No. 13 of 1994), Schedule, Part I" {
    source "https://web.archive.org/web/20251206125932/https://zambialii.org/akn/zm/act/1965/23/eng@1996-12-31"
    source "https://web.archive.org/web/20251231163152im_/https://media.zambialii.org/media/legislation/19688/images/6b7bf02ccfd67a7d/National_Flag_1.JPG"
    source "https://web.archive.org/web/20260217021745/https://www.policyvault.africa/wp-content/uploads/policy/ZMB752.pdf"
  }
  restriction "Section 4: without the Minister's written permission, no one may apply the National Flag or any part of its design to goods, or use it in connection with a business in a way that suggests authorization." {
    source "https://web.archive.org/web/20251206125932/https://zambialii.org/akn/zm/act/1965/23/eng@1996-12-31"
  }
}
palette {
  green "#00ab39" {
    pantone "354 C"
    cmyk 79 0 98 0
    reference "British Colour Council" "Spectrum Green, shade 100"
  }
  red "#e62d23" {
    pantone "032 C"
    cmyk 0 92 89 0
    reference "British Colour Council" "Union Jack Red, shade 210"
  }
  black "#000000" {
    reference "British Colour Council" "Jet Black, shade 220"
  }
  orange "#ff7300" {
    pantone "151 C"
    cmyk 0 65 94 0
    reference "British Colour Council" "Spectrum Orange, shade 57"
  }
}
proportion hoist=14 fly=21

field green
panel {
  corner lower-fly
  fly 7.5
  hoist 9
  bars red black orange {
    along hoist
  }
}
charge svg orange {
  at fly=17.25 hoist=2.5
  fly 5.4441
  hoist 2.6438
  markup #"""
