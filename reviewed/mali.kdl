// From the law: Article 30 of the 2023 Constitution, three equal vertical bands of
// green, gold and red, in that order.
// From elsewhere: the law gives no proportion or shade. 2:3 and the colors are as FOTW
// reports them, the colors being the Album des Pavillons 2023's.
vexyl 1
meta {
  name "Mali"
  encoder "Naomi Persephone Amethyst"
  license "CC-BY-SA-4.0"
  render-license "CC0-1.0"
  source "https://web.archive.org/web/20261015103204id_/https://sgg-mali.ml/JO/2023/mali-jo-2023-13-sp-2.pdf"
  source "https://www.crwflags.com/fotw/flags/ml.html"
  note "The Constitution gives no proportion. The 2:3 is FOTW's, not a legal value."
  note "The Constitution gives no shades. The hex, Pantone and CMYK values are the Album des Pavillons 2023's, as reported by FOTW. The Album itself wasn't read."
  note "FOTW prints the gold's CMYK as 0-19-9-0, an apparent misprint. The CMYK here, 0-19-93-0, is what FOTW reports from the same Album for Pantone 116 C on its pages for Namibia, Palestine and Peru."
  note "Law No. 61-26 of 20 January 1961 is known here only from the Presidency's account quoted by FOTW. Its text wasn't read."
  law "Constitution of the Republic of Mali, promulgated by Decree No. 2023-0401/PT-RM of 22 July 2023, Article 30" {
    source "https://web.archive.org/web/20261015103204id_/https://sgg-mali.ml/JO/2023/mali-jo-2023-13-sp-2.pdf"
  }
  law "Law No. 61-26 of 20 January 1961 on the national flag"
}
palette {
  green "#12ad2b" {
    pantone "361 C"
    cmyk 78 0 100 0
  }
  gold "#ffce00" {
    pantone "116 C"
    cmyk 0 19 93 0
  }
  red "#d21034" {
    pantone "186 C"
    cmyk 10 100 74 2
  }
}
proportion hoist=2 fly=3

bars green gold red {
  along hoist
}
